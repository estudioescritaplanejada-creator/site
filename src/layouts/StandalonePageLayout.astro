---
import SeoHead from '../components/seo/SeoHead.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  noindex?: boolean;
  nofollow?: boolean;
  author?: string;
  siteName?: string;
  image?: string;
  imageAlt?: string;
  socialTitle?: string;
  socialDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  themeColor?: string;
  colorScheme?: string;
  lang?: string;
  bodyClass?: string;
  bodyDataPage?: string;
  faviconSvg?: string;
  faviconPng?: string;
  appleTouchIcon?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  nofollow = true,
  author = 'Estúdio Escrita Planejada',
  siteName = 'Estúdio Escrita Planejada',
  image,
  imageAlt,
  socialTitle,
  socialDescription,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterImageAlt,
  themeColor,
  colorScheme,
  lang = 'pt-BR',
  bodyClass,
  bodyDataPage,
  faviconSvg = '/favicon.svg',
  faviconPng = '/favicon-48.png',
  appleTouchIcon = '/apple-touch-icon.png',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    {themeColor && <meta name="theme-color" content={themeColor} />}
    {colorScheme && <meta name="color-scheme" content={colorScheme} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      nofollow={nofollow}
      author={author}
      siteName={siteName}
      image={image}
      imageAlt={imageAlt}
      socialTitle={socialTitle}
      socialDescription={socialDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
      twitterImage={twitterImage}
      twitterImageAlt={twitterImageAlt}
    />

    {faviconSvg && (
      <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    )}

    {faviconPng && (
      <link
        rel="icon"
        type="image/png"
        sizes="48x48"
        href={faviconPng}
      />
    )}

    {appleTouchIcon && (
      <link rel="apple-touch-icon" href={appleTouchIcon} />
    )}

    <slot name="head" />
  </head>

  <body class={bodyClass} data-page={bodyDataPage}>
    <slot />
    <GoogleAnalytics />
  </body>
</html>
