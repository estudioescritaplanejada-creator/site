---
type PromotionType =
  | 'sistema-criador-digital'
  | 'afiliados';

interface Props {
  articleSlug: string;
  promotion?: PromotionType;
}

const {
  articleSlug,
  promotion = 'sistema-criador-digital',
} = Astro.props;

const newPromotion = {
  landingHref: '/enquanto/da-sua-cozinha-para-os-primeiros-clientes/',
  checkoutHref: 'https://pay.hotmart.com/M107050060Q',
  label: 'Da Sua Cozinha para os Primeiros Clientes',
  ctaLabel: 'Clique na imagem e conheça',
  imagePath:
    '/assets/promocoes/da-sua-cozinha-para-os-primeiros-clientes/banner.webp',
  alt:
    'Da Sua Cozinha para os Primeiros Clientes, produto digital do Estúdio Escrita Planejada',
  ctaType: 'product',
  disclosure: 'Produto digital do Estúdio Escrita Planejada.',
};

const promotions = {
  'sistema-criador-digital': newPromotion,
  afiliados: newPromotion,
} satisfies Record<PromotionType, typeof newPromotion>;

const selected = promotions[promotion];
---

<aside
  class="article-promotion"
  aria-label="Conteúdo recomendado"
  data-promotion="da-sua-cozinha-para-os-primeiros-clientes"
>
  <a
    class="article-promotion__cta"
    href={selected.checkoutHref}
    data-analytics-event="commercial_cta_click"
    data-article-slug={articleSlug}
    data-cta-type={selected.ctaType}
    data-cta-label={selected.ctaLabel}
    data-cta-position="article_promotion_text"
  >
    {selected.ctaLabel}
  </a>

  <a
    class="article-promotion__link"
    href={selected.landingHref}
    aria-label={`Conheça ${selected.label}`}
    data-analytics-event="commercial_cta_click"
    data-article-slug={articleSlug}
    data-cta-type={selected.ctaType}
    data-cta-label={selected.label}
    data-cta-position="article_promotion_image"
  >
    <img
      src={selected.imagePath}
      width="1920"
      height="1080"
      alt={selected.alt}
      loading="lazy"
      decoding="async"
    />
  </a>

  <p class="article-promotion__disclosure">
    {selected.disclosure}
  </p>
</aside>
