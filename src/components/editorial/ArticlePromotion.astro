---
type PromotionType = 'site-profissional';

interface Props {
  articleSlug: string;
  promotion?: PromotionType;
}

const { articleSlug } = Astro.props;

const promotion = {
  landingHref: '/site-profissional/',
  label: 'Criação de sites profissionais',
  imagePath: '/assets/promocoes/site-profissional/card.webp',
  alt:
    'Criação de sites profissionais pelo Estúdio Escrita Planejada, com projetos a partir de R$ 290',
  ctaType: 'service',
};
---

<aside
  class="article-promotion"
  aria-label="Serviço recomendado"
  data-promotion="site-profissional"
>
  <a
    class="article-promotion__link"
    href={promotion.landingHref}
    aria-label="Conheça o serviço de criação de sites profissionais do Estúdio Escrita Planejada"
    data-analytics-event="commercial_cta_click"
    data-article-slug={articleSlug}
    data-cta-type={promotion.ctaType}
    data-cta-label={promotion.label}
    data-cta-position="article_promotion_image"
  >
    <img
      src={promotion.imagePath}
      width="1448"
      height="1086"
      alt={promotion.alt}
      loading="lazy"
      decoding="async"
    />
  </a>
</aside>

<style>
  .article-promotion__link {
    display: block;
  }

  .article-promotion__link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
</style>
