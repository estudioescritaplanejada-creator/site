---
type PromotionType =
  | 'sistema-criador-digital'
  | 'afiliados';

interface Props {
  articleSlug: string;
  promotion?: PromotionType;
}

const {
  articleSlug,
  promotion = 'sistema-criador-digital',
} = Astro.props;

const promotions = {
  'sistema-criador-digital': {
    href: '/sistema-criador-digital/',
    label: 'Conheça o Sistema Criador Digital com IA',
    imagePath:
      '/assets/promocoes/sistema-criador-digital',
    alt:
      'Criador Digital com IA: aprenda a organizar ideias, criar conteúdo e desenvolver projetos',
    ctaType: 'product',
    disclosure: 'Conteúdo do Estúdio Escrita Planejada.',
  },
  afiliados: {
    href: '/afiliados-sistema-criador-digital/',
    label:
      'Conheça o programa de afiliados do Sistema Criador Digital',
    imagePath: '/assets/promocoes/afiliados',
    alt:
      'Divulgue o Sistema Criador Digital e conheça o programa de afiliados',
    ctaType: 'affiliate',
    disclosure:
      'Programa de afiliados do Estúdio Escrita Planejada.',
  },
} satisfies Record<
  PromotionType,
  {
    href: string;
    label: string;
    imagePath: string;
    alt: string;
    ctaType: string;
    disclosure: string;
  }
>;

const selected = promotions[promotion];
---

<aside
  class="article-promotion"
  aria-label="Conteúdo recomendado"
  data-promotion={promotion}
>
  <a
    class="article-promotion__link"
    href={selected.href}
    aria-label={selected.label}
    data-analytics-event="commercial_cta_click"
    data-article-slug={articleSlug}
    data-cta-type={selected.ctaType}
    data-cta-label={selected.label}
  >
    <picture>
      <source
        media="(max-width: 700px)"
        srcset={`${selected.imagePath}/vertical.webp`}
        width="1086"
        height="1448"
      />

      <img
        src={`${selected.imagePath}/horizontal.webp`}
        width="1448"
        height="1086"
        alt={selected.alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
  </a>

  <p class="article-promotion__disclosure">
    {selected.disclosure}
  </p>
</aside>
