---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
}

const { src, alt, width, height } = Astro.props;
---

<section class="article-hero" aria-label="Imagem principal do artigo">
  <div class="editorial-container article-hero__inner">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>
