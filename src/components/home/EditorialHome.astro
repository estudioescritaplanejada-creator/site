---
import LegalLinks from '../legal/LegalLinks.astro';
import { getCollection } from 'astro:content';
import {
  articlePath,
  categoryPath,
  formatArticleDate,
  isPublished,
  sortArticles,
} from '../../lib/editorial';
import '../../styles/home-v2.css';

const publishedArticles = sortArticles(
  await getCollection('articles', (article) => isPublished(article)),
);

const latestArticles = publishedArticles.slice(0, 6);

const activeCategories = new Set<string>(
  publishedArticles.map((article) => article.data.category),
);

const whatsappUrl =
  'https://wa.me/5511964502997?text=Ol%C3%A1%21%20Conheci%20o%20Est%C3%BAdio%20Escrita%20Planejada%20e%20quero%20entender%20como%20voc%C3%AAs%20podem%20me%20ajudar.';

const homeCategoryLabel = {
  'protecao-digital': 'Segurança digital',
  'decisoes-digitais': 'Escolha de ferramentas',
  'rotina-digital': 'Organização do trabalho',
  'ferramentas-e-ia': 'Inteligência artificial',
  'produtos-digitais': 'Produtos digitais',
} as const;

const problemPaths = [
  {
    number: '01',
    label: 'Segurança',
    title: 'Tenho medo de cair em um golpe ou perder uma conta.',
    text: 'Celular roubado, WhatsApp, PIX, links suspeitos, senhas, autenticação e proteção de dados.',
    action: 'Quero me proteger',
    href: '/guias/tema/protecao-digital/',
  },
  {
    number: '02',
    label: 'Organização',
    title: 'Estou me perdendo entre mensagens, cobranças e tarefas.',
    text: 'Atendimento, agenda, pedidos, prazos, arquivos, clientes e acompanhamento.',
    action: 'Quero colocar em ordem',
    href: '/guias/tema/rotina-digital/',
  },
  {
    number: '03',
    label: 'Decisões digitais',
    title: 'Não sei se vale a pena pagar por uma ferramenta ou serviço.',
    text: 'Planos, assinaturas, armazenamento, CRM, ferramentas prontas e decisões antes de gastar dinheiro.',
    action: 'Quero decidir melhor',
    href: '/guias/tema/decisoes-digitais/',
  },
  {
    number: '04',
    label: 'Ferramentas e IA',
    title: 'Quero usar IA e ferramentas sem me complicar.',
    text: 'Inteligência artificial, aplicativos e ferramentas para escrever, produzir, organizar e atender melhor.',
    action: 'Quero usar melhor',
    href: '/guias/tema/ferramentas-e-ia/',
  },
  {
    number: '05',
    label: 'Produto digital',
    title: 'Quero transformar o que sei em algo que possa vender.',
    text: 'Ideia, validação, formato, preço, página de vendas, divulgação e afiliados.',
    action: 'Quero começar',
    href: '/guias/tema/produtos-digitais/',
  },
];

---

<a class="home-skip" href="#conteudo">Ir para o conteúdo principal</a>

<div class="utility-bar">
  <div class="home-container utility-bar__inner">
    <span>Conteúdo prático</span>
    <span aria-hidden="true">•</span>
    <span>Respostas para quem trabalha por conta própria</span>
  </div>
</div>

<header class="home-header">
  <div class="home-container home-header__inner">
    <a
      class="home-brand"
      href="/"
      aria-label="Estúdio Escrita Planejada - página inicial"
    >
      <span class="home-brand__mark">EEP</span>
      <span class="home-brand__name">Estúdio Escrita Planejada</span>
    </a>

    <nav class="home-nav" aria-label="Navegação principal">
      <a href="#publicacoes">Publicações</a>
      <a href="#problemas">Por problema</a>
      <a href="#ajuda">Ajuda para fazer</a>
      <a href="/sobre/">Sobre</a>
    </nav>

    <a class="home-header__cta" href="/guias/">Encontrar uma resposta</a>

    <details class="home-menu">
      <summary aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Navegação móvel">
        <a href="#publicacoes">Publicações</a>
        <a href="#problemas">Por problema</a>
          <a href="#ajuda">Ajuda para fazer</a>
        <a href="/sobre/">Sobre</a>
        <a href="/guias/">Encontrar uma resposta</a>
      </nav>
    </details>
  </div>
</header>

<main id="conteudo">
  <section class="home-v2-hero" aria-labelledby="home-title">
    <div class="home-container home-v2-hero__inner">
      <div class="home-v2-hero__copy">
        <picture class="home-v2-hero__picture">
          <source
            media="(max-width: 48rem)"
            srcset="/assets/home/hero/eep-hero-mobile-photo-4x5.webp"
          />
          <img
            src="/assets/home/hero/eep-hero-desktop-4x5.webp"
            width="1280"
            height="1600"
            alt="Mulher trabalhando durante sua rotina profissional"
            decoding="async"
            fetchpriority="high"
          />
        </picture>

        <div class="home-v2-hero__copy-content">
          <p class="eyebrow">
            Conteúdo prático para quem trabalha por conta própria
          </p>

          <h1 id="home-title">
            Respostas claras para os problemas digitais do seu trabalho.
          </h1>

          <p class="home-v2-hero__lead">
            Aprenda a proteger suas contas, evitar golpes, organizar mensagens e
            cobranças, usar inteligência artificial, escolher ferramentas e
            transformar o que você sabe em produtos digitais.
          </p>

          <p class="home-v2-hero__support">
            Conteúdo gratuito, direto ao ponto e pensado para situações que
            aparecem no trabalho de verdade.
          </p>
        </div>
      </div>

      <div class="home-v2-paths" aria-label="Escolha como começar">
        <article class="home-v2-path home-v2-path--content">
          <span class="home-v2-path__number">01</span>
          <p class="home-v2-path__label">Quero resolver por conta própria</p>
          <h2>Procure a resposta que você precisa.</h2>
          <p>
            Segurança, organização, inteligência artificial, ferramentas e
            produtos digitais.
          </p>
          <a
            class="home-button home-button--primary"
            href="/guias/"
          >
            Encontrar uma resposta
          </a>
        </article>

        <article class="home-v2-path home-v2-path--help">
          <span class="home-v2-path__number">02</span>
          <p class="home-v2-path__label">Quero ajuda para fazer</p>
          <h2>Tem coisa que você não precisa fazer sozinho.</h2>
          <p>
            Sites, organização do trabalho digital e criação de materiais ou
            produtos.
          </p>
          <a
            class="home-button home-button--secondary"
            href="#ajuda"
          >
            Ver como podemos ajudar
          </a>
        </article>
      </div>
    </div>
  </section>

  <section
    class="home-v2-latest"
    id="publicacoes"
    aria-labelledby="latest-title"
    data-latest-rail
  >
    <div class="home-container">
      <div class="home-v2-heading home-v2-heading--latest">
        <div>
          <p class="eyebrow">Publicado recentemente</p>
          <h2 id="latest-title">
            Novas respostas para problemas do dia a dia
          </h2>
        </div>

        <div class="home-v2-heading__side">
          <p>
            Veja os conteúdos mais recentes publicados pelo Estúdio.
          </p>

          <div class="home-v2-rail-controls" aria-label="Navegar pelas publicações">
            <button
              type="button"
              data-latest-prev
              aria-label="Ver publicações anteriores"
            >
              ←
            </button>
            <button
              type="button"
              data-latest-next
              aria-label="Ver próximas publicações"
            >
              →
            </button>
          </div>
        </div>
      </div>

      <div
        class="home-v2-latest__track"
        data-latest-track
        tabindex="0"
        aria-label="Publicações recentes"
      >
        {latestArticles.map((article) => (
          <article class="home-v2-latest-card">
            <div class="home-v2-latest-card__meta">
              <a href={categoryPath(article.data.category)}>
                {homeCategoryLabel[article.data.category]}
              </a>
              <time datetime={article.data.publishedAt.toISOString()}>
                {formatArticleDate(article.data.publishedAt)}
              </time>
            </div>

            <h3>
              <a href={articlePath(article)}>
                {article.data.title}
              </a>
            </h3>

            <p>{article.data.description}</p>

            <a
              class="home-v2-latest-card__action"
              href={articlePath(article)}
            >
              Ler
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <div class="home-v2-latest__footer">
        <a class="home-button home-button--secondary" href="/guias/">
          Ver todas as publicações
        </a>
      </div>

      <aside
        class="home-v2-preferred-source"
        aria-labelledby="preferred-source-title"
      >
        <div class="home-v2-preferred-source__copy">
          <p class="eyebrow">Acompanhe o Estúdio no Google</p>

          <h3 id="preferred-source-title">
            Adicione o Estúdio às suas fontes preferidas.
          </h3>

          <p>
            O Google poderá destacar nossos conteúdos para você quando forem
            relevantes em Principais notícias, no Modo IA e nas Visões gerais
            criadas por IA.
          </p>
        </div>

        <div class="home-v2-preferred-source__action">
          <div google-add-preferred-source-btn data-theme="light"></div>
        </div>
      </aside>
    </div>
  </section>

  <section
    class="home-v2-problems"
    id="problemas"
    aria-labelledby="problems-title"
  >
    <span
      id="ferramentas"
      class="home-v2-anchor-alias"
      aria-hidden="true"
    ></span>
    <div class="home-container">
      <div class="home-v2-heading home-v2-heading--light">
        <div>
          <p class="eyebrow eyebrow--light">Não sabe por onde começar?</p>
          <h2 id="problems-title">O que está dando trabalho hoje?</h2>
        </div>
        <p>
          Escolha a situação que mais se parece com a sua.
        </p>
      </div>

      <div class="home-v2-problem-grid">
        {problemPaths.map((problem) => (
          <a class="home-v2-problem-card" href={problem.href}>
            <span class="home-v2-problem-card__meta">
              {problem.number} · {problem.label}
            </span>
            <h3>{problem.title}</h3>
            <p>{problem.text}</p>
            <span class="home-v2-problem-card__action">
              {problem.action} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section
    class="home-v2-help"
    id="ajuda"
    aria-labelledby="help-title"
  >
    <span
      id="servicos"
      class="home-v2-anchor-alias"
      aria-hidden="true"
    ></span>
    <div class="home-container">
      <div class="home-v2-heading home-v2-heading--help">
        <div>
          <p class="eyebrow">Se você preferir ter ajuda</p>
          <h2 id="help-title">
            Tem coisa que você não precisa fazer sozinho.
          </h2>
        </div>
        <p>
          Além dos conteúdos gratuitos, o Estúdio pode ajudar a colocar alguns
          desses trabalhos em prática.
        </p>
      </div>

      <div class="home-v2-help-grid">
        <article class="home-v2-help-card home-v2-help-card--primary">
          <span class="home-v2-help-card__number">01</span>
          <p class="home-v2-help-card__label">
            Quero um site para mostrar meu trabalho
          </p>
          <h3>Um lugar simples e profissional para apresentar o que você faz.</h3>
          <p>
            Reúna seus serviços, informações, fotos e formas de contato em uma
            página rápida e adaptada ao celular.
          </p>
          <a
            class="home-button home-button--light"
            href="/site-profissional/"
          >
            Ver como funciona
          </a>
          <small>Projetos a partir de R$ 490*</small>
        </article>

        <article class="home-v2-help-card">
          <span class="home-v2-help-card__number">02</span>
          <p class="home-v2-help-card__label">
            Quero organizar melhor meu atendimento
          </p>
          <h3>Coloque mensagens, informações e etapas em uma ordem mais simples.</h3>
          <p>
            Organizamos a forma como seu trabalho se apresenta e atende para
            reduzir dúvidas e facilitar a rotina.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Entender como funciona →
          </a>
        </article>

        <article class="home-v2-help-card">
          <span class="home-v2-help-card__number">03</span>
          <p class="home-v2-help-card__label">
            Quero transformar o que sei em um produto
          </p>
          <h3>Organize seu conhecimento para publicar, entregar ou vender.</h3>
          <p>
            Você traz o que sabe. O Estúdio ajuda a estruturar, escrever,
            apresentar e preparar o material.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Quero contar minha ideia →
          </a>
        </article>
      </div>
    </div>
  </section>

  <section
    class="home-v2-final"
    aria-labelledby="final-title"
  >
    <div class="home-container home-v2-final__panel">
      <div>
        <p class="eyebrow eyebrow--light">Estúdio Escrita Planejada</p>
        <h2 id="final-title">
          Pode começar pelo problema que você tem hoje.
        </h2>
      </div>

      <div class="home-v2-final__action">
        <p>
          Procure uma resposta entre os conteúdos publicados. Se precisar de
          ajuda para colocar alguma coisa em prática, fale com o Estúdio.
        </p>

        <div class="home-v2-final__buttons">
          <a
            class="home-button home-button--acid"
            href="/guias/"
          >
            Encontrar uma resposta
          </a>

          <a
            class="home-button home-button--light"
            href="#ajuda"
          >
            Ver como podemos ajudar
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="home-footer">
  <div class="home-container home-footer__grid">
    <div>
      <a class="home-brand home-brand--footer" href="/">
        <span class="home-brand__mark">EEP</span>
        <span class="home-brand__name">Estúdio Escrita Planejada</span>
      </a>
      <p>
        Conteúdo prático e ajuda para quem trabalha por conta própria e precisa
        lidar todos os dias com tecnologia, organização e clientes.
      </p>
    </div>

    <nav aria-label="Links principais">
      <a href="#publicacoes">Publicações</a>
      <a href="#problemas">Por problema</a>
      <a href="#ajuda">Ajuda para fazer</a>
      <a href="/sobre/">Sobre</a>
      <a href="/guias/">Todos os conteúdos</a>
    </nav>

    <div class="home-footer__legal">
      <p>Atendimento online em todo o Brasil</p>
      <p>
        <a href="mailto:estudioescritaplanejada@gmail.com">
          estudioescritaplanejada@gmail.com
        </a>
      </p>
      <p>© 2026 Estúdio Escrita Planejada</p>
      <LegalLinks />
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('[data-latest-rail]');

    sections.forEach((section) => {
      const track = section.querySelector('[data-latest-track]');
      const previous = section.querySelector('[data-latest-prev]');
      const next = section.querySelector('[data-latest-next]');

      if (
        !(track instanceof HTMLElement) ||
        !(previous instanceof HTMLButtonElement) ||
        !(next instanceof HTMLButtonElement)
      ) {
        return;
      }

      const scrollAmount = () =>
        Math.max(track.clientWidth * 0.82, 280);

      previous.addEventListener('click', () => {
        track.scrollBy({
          left: -scrollAmount(),
          behavior: 'smooth',
        });
      });

      next.addEventListener('click', () => {
        track.scrollBy({
          left: scrollAmount(),
          behavior: 'smooth',
        });
      });
    });
  })();
</script>
