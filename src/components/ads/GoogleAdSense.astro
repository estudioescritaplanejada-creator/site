---
/**
 * Google AdSense / Auto Ads
 *
 * Monetização habilitada somente nos artigos editoriais individuais:
 * /guias/<slug>/
 *
 * Páginas de coleção, categorias, institucionais, comerciais,
 * legais, técnicas e demonstrações permanecem sem código publicitário.
 */

const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);

const adsenseEnabled =
  segments.length === 2 &&
  segments[0] === 'guias' &&
  segments[1] !== 'tema';
---

{
  adsenseEnabled && (
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4266020173915588"
      crossorigin="anonymous"
      data-eep-google-adsense="true"
    ></script>
  )
}
