              Explore caminhos para serviços, produtos, conteúdo e renda
              criativa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="oferta">
      <div class="container offer-grid">
        <div class="offer-image">
          <img
            src="/assets/produtos/sistema-criador-digital/oferta.webp"
