            <img
              src="/assets/produtos/sistema-criador-digital/hero.webp"
              alt="Sistema Criador Digital com IA"
              width="1086"
              height="1448"
            >
          </div>

          <div class="hero-badge">
            Seu projeto começa aqui
          </div>
        </div>
      </div>
    </section>

    <div class="proof">
      <div class="container proof-grid">
        <div class="proof-item">
          <strong>7 módulos</strong>
          <span>Um caminho completo para começar.</span>
        </div>

        <div class="proof-item">
          <strong>Acesso vitalício</strong>
          <span>Compre uma vez e acesse para sempre.</span>
