---
import CommercialLandingLayout from '../../layouts/CommercialLandingLayout.astro';
import LandingContent from '../../components/site-profissional/LandingContent.astro';
const title =
  'Criação de sites e landing pages para pequenos negócios | Estúdio Escrita Planejada';

const description =
  'Criação e reformulação de páginas profissionais e landing pages para autônomos, MEIs e pequenos negócios, com textos, design, publicação e contato pelo WhatsApp.';

const canonicalPath = '/site-profissional/';
const baseUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, baseUrl).toString();
const siteUrl = new URL('/', baseUrl).toString();
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const serviceId = `${canonicalUrl}#service`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Estúdio Escrita Planejada',
      url: siteUrl,
      telephone: '+55 11 96450-2997',
      email: 'estudioescritaplanejada@gmail.com',
      areaServed: {
        '@type': 'Country',
        name: 'Brasil',
      },
      logo: new URL('/assets/img/logo.png', baseUrl).toString(),
      image: new URL(
        '/assets/img/og-estudio-escrita-planejada.jpg',
        baseUrl,
      ).toString(),
      taxID: '61.424.633/0001-11',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Estúdio Escrita Planejada',
      inLanguage: 'pt-BR',
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalUrl,
      name: 'Criação de sites e landing pages para pequenos negócios',
      description:
        'Criação e reformulação de páginas profissionais para apresentar negócios, serviços, produtos e ofertas com clareza.',
      isPartOf: {
        '@id': websiteId,
      },
      about: {
        '@id': serviceId,
      },
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Criação de páginas profissionais e landing pages',
      description:
        'Criação de páginas profissionais do zero, landing pages para ofertas específicas e reformulação de páginas existentes, com organização, redação, design, publicação e adaptação para celular e computador.',
      provider: {
        '@id': organizationId,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Brasil',
      },
      serviceType:
        'Criação e reformulação de páginas profissionais para pequenos negócios',
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: '290.00',
        priceCurrency: 'BRL',
        offerCount: 3,
        url: `${canonicalUrl}#investimento`,
      },
    },
  ],
};
---

<CommercialLandingLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image="/assets/img/og-estudio-escrita-planejada.jpg"
  imageAlt="Exemplo de página profissional exibida em notebook e celular"
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  ></script>

  <LandingContent />

  <script>
    import '../../scripts/site-profissional.js';
  </script>
</CommercialLandingLayout>
