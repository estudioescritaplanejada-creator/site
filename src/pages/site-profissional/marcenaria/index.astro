---
import StandalonePageLayout from '../../../layouts/StandalonePageLayout.astro';
import '../../../styles/marcenaria.css';

const whatsappUrl = 'https://wa.me/5511964502997?text=Ol%C3%A1%21%20Vim%20pela%20p%C3%A1gina%20da%20EEP%20Marcenaria%20e%20gostaria%20de%20pedir%20um%20or%C3%A7amento%20para%20m%C3%B3veis%20sob%20medida.';

const services = [
  {
    title: 'Cozinhas planejadas',
    text: 'Armários, bancadas, torres, nichos e soluções de armazenamento desenvolvidos conforme o espaço disponível e a rotina da casa.',
    cta: 'Mostrar minha cozinha',
  },
  {
    title: 'Guarda-roupas e closets',
    text: 'Projetos internos e externos pensados para organizar roupas, calçados, acessórios e objetos de forma prática.',
    cta: 'Pedir orçamento',
  },
  {
    title: 'Painéis e móveis para sala',
    text: 'Painéis para TV, racks, estantes, aparadores e móveis integrados ao ambiente.',
    cta: 'Mostrar meu espaço',
  },
  {
    title: 'Home office',
    text: 'Mesas, gaveteiros, armários e soluções para criar um espaço de trabalho funcional mesmo em ambientes compactos.',
    cta: 'Quero um projeto',
  },
  {
    title: 'Banheiros e lavanderias',
    text: 'Gabinetes, armários e móveis desenvolvidos para aproveitar áreas menores e organizar itens de uso diário.',
    cta: 'Pedir uma avaliação',
  },
  {
    title: 'Móveis para empresas',
    text: 'Balcões, armários, recepções, nichos, estações de trabalho e soluções sob medida para pequenos negócios.',
    cta: 'Falar sobre meu projeto',
  },
];

const issues = [
  'Uma cozinha pequena que precisa de mais armazenamento?',
  'Um quarto onde móveis prontos não aproveitam bem a parede?',
  'Um canto difícil de utilizar?',
  'Um home office que precisa caber em pouco espaço?',
  'Uma lavanderia que precisa ficar mais organizada?',
  'Um painel ou rack integrado à sala?',
  'Um balcão ou recepção para seu negócio?',
  'Um ambiente que precisa funcionar melhor no dia a dia?',
];

const reasons = [
  {
    title: 'Aproveitamento do espaço',
    text: 'Medidas, cantos, alturas e áreas pouco utilizadas podem ser incorporados ao projeto.',
  },
  {
    title: 'Organização interna',
    text: 'Prateleiras, gavetas, cabideiros e divisões são pensados conforme aquilo que realmente será guardado.',
  },
  {
    title: 'Acabamento cuidadoso',
    text: 'Encontros, alinhamento, portas, puxadores e detalhes finais influenciam diretamente na percepção do móvel.',
  },
  {
    title: 'Materiais adequados',
    text: 'A escolha dos materiais considera o tipo de ambiente, utilização e acabamento desejado.',
  },
  {
    title: 'Fabricação sob medida',
    text: 'Cada projeto parte das dimensões e das necessidades reais do ambiente.',
  },
  {
    title: 'Instalação',
    text: 'O resultado final depende tanto da fabricação quanto de uma montagem cuidadosa no local.',
  },
];

const works = [
  {
    title: 'Cozinha sob medida',
    place: 'Curitiba — Água Verde',
    text: 'Armários desenvolvidos considerando eletrodomésticos, circulação, armazenamento e dimensões reais do ambiente.',
  },
  {
    title: 'Guarda-roupa para quarto',
    place: 'Curitiba — Portão',
    text: 'Projeto pensado para aproveitar toda a altura disponível e organizar diferentes tipos de roupas e objetos.',
  },
  {
    title: 'Painel e rack para sala',
    place: 'Curitiba — Boa Vista',
    text: 'Conjunto desenvolvido para integrar televisão, equipamentos, decoração e armazenamento sem sobrecarregar o ambiente.',
  },
  {
    title: 'Home office compacto',
    place: 'São José dos Pinhais',
    text: 'Mesa, nichos e armários planejados para transformar um pequeno espaço em área de trabalho.',
  },
  {
    title: 'Mobiliário para recepção comercial',
    place: 'Pinhais',
    text: 'Balcão e armários desenvolvidos conforme a circulação e as necessidades de atendimento do estabelecimento.',
  },
];

const testimonials = [
  {
    name: 'Fernanda M. — Curitiba',
    text: 'Queríamos aproveitar uma parede inteira da cozinha, mas os móveis prontos nunca encaixavam direito. O projeto criou bastante espaço de armazenamento sem deixar o ambiente pesado.',
  },
  {
    name: 'Rodrigo A. — Curitiba',
    text: 'Enviei algumas referências e expliquei o que precisava guardar no quarto. O resultado ficou muito mais funcional do que o guarda-roupa que tínhamos antes.',
  },
  {
    name: 'Patrícia C. — São José dos Pinhais',
    text: 'O home office precisava caber em um espaço pequeno. Conseguiram aproveitar a parede com mesa, gavetas e armário sem atrapalhar a circulação.',
  },
  {
    name: 'Marcelo R. — Curitiba',
    text: 'Gostei principalmente do acabamento e da organização durante a instalação. O móvel ficou muito bem integrado ao restante da sala.',
  },
];

const metroCities = [
  'São José dos Pinhais',
  'Pinhais',
  'Colombo',
  'Araucária',
  'Almirante Tamandaré',
  'Campo Largo',
  'Fazenda Rio Grande',
];

const neighborhoods = [
  'Água Verde',
  'Batel',
  'Boa Vista',
  'Cabral',
  'Centro',
  'Cristo Rei',
  'Mercês',
  'Portão',
  'Santa Felicidade',
  'Seminário',
  'Uberaba',
  'Xaxim',
];

const residentialServices = ['cozinhas', 'quartos', 'closets', 'salas', 'home offices', 'banheiros', 'lavanderias', 'áreas gourmet'];
const businessServices = ['recepções', 'balcões', 'armários', 'estantes', 'nichos', 'estações de trabalho', 'móveis de apoio'];

const faq = [
  {
    q: 'Vocês fazem móveis totalmente sob medida?',
    a: 'Sim. Os projetos são desenvolvidos considerando as dimensões e necessidades de cada ambiente.',
  },
  {
    q: 'Posso pedir orçamento enviando apenas uma foto?',
    a: 'Sim. Uma foto do ambiente ajuda bastante no primeiro contato. Se também tiver medidas aproximadas ou referências, pode enviá-las junto.',
  },
  {
    q: 'Preciso ter um projeto de arquiteto?',
    a: 'Não. Você pode entrar em contato apenas com sua ideia e as informações que já possui.',
  },
  {
    q: 'Posso mandar uma referência da internet?',
    a: 'Sim. Referências ajudam a explicar estilo, organização ou solução desejada. O projeto final é adaptado às características reais do ambiente.',
  },
  {
    q: 'Vocês fazem a instalação?',
    a: 'Sim. Fabricação e instalação fazem parte do serviço conforme o projeto contratado.',
  },
  {
    q: 'Trabalham somente com residências?',
    a: 'Não. Também desenvolvemos móveis para pequenos negócios e ambientes comerciais.',
  },
  {
    q: 'Como é calculado o orçamento?',
    a: 'O valor depende principalmente das dimensões, configuração do móvel, materiais, ferragens, acabamento e complexidade de fabricação e instalação.',
  },
  {
    q: 'Quais formas de pagamento são aceitas?',
    a: 'Pix, cartão de débito e cartão de crédito conforme as condições apresentadas no orçamento.',
  },
];
---

<StandalonePageLayout
  title="Marcenaria em Curitiba | EEP Marcenaria"
  description="Página demonstrativa para móveis planejados e projetos sob medida em Curitiba e Região Metropolitana. Demonstração criada pelo Estúdio Escrita Planejada."
  canonicalPath="/site-profissional/marcenaria/"
  noindex={true}
  nofollow={false}
  themeColor="#34261f"
  bodyDataPage="marcenaria"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="demo-strip" id="aviso-demo">
    <span>Página demonstrativa • empresa e dados comerciais fictícios</span>
    <a href="#sobre-demo">Sobre esta demonstração</a>
  </div>

  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href="#inicio" aria-label="Voltar ao início">
        <span class="brand-mark">E</span>
        <span class="brand-copy">
          <strong>EEP</strong>
          <small>Marcenaria</small>
        </span>
      </a>

      <nav class="main-nav" aria-label="Navegação principal" id="main-nav">
        <a href="#servicos">Ambientes</a>
        <a href="#trabalhos">Projetos</a>
        <a href="#atendimento">Atendimento</a>
        <a href="#faq">FAQ</a>
        <a class="btn btn-primary nav-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Pedir orçamento</a>
      </nav>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div class="container">
        <div class="hero-stage">
          <picture class="hero-media" aria-hidden="true">
            <source media="(max-width: 767px)" srcset="/site-profissional/marcenaria/img/hero-mobile.webp" />
            <img src="/site-profissional/marcenaria/img/hero-desktop.webp" alt="" width="1448" height="1086" fetchpriority="high" decoding="async" />
          </picture>
          <div class="hero-overlay"></div>

          <div class="hero-inner">
            <div class="hero-copy">
              <p class="eyebrow accent">MARCENARIA • CURITIBA E REGIÃO</p>
              <h1>Móveis sob medida para aproveitar melhor <span>cada espaço</span></h1>
              <p class="hero-lead">Projetos personalizados para cozinhas, quartos, salas, home offices e ambientes comerciais.</p>
              <p class="hero-text">Envie uma foto do ambiente, uma referência ou as medidas aproximadas e conte o que você gostaria de fazer.</p>

              <div class="hero-actions">
                <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Mostrar meu ambiente pelo WhatsApp</a>
                <a class="btn btn-ghost" href="#servicos">Ver ambientes</a>
              </div>
            </div>
          </div>

          <div class="hero-proof">
            <div>
              <strong>Projetos sob medida</strong>
              <span>Do ambiente à instalação</span>
            </div>
            <div>
              <strong>Atendimento local</strong>
              <span>Curitiba e Região Metropolitana</span>
            </div>
            <div>
              <strong>Residencial e comercial</strong>
              <span>Casa • escritório • pequeno negócio</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section intro">
      <div class="container split-grid split-grid--reverse">
        <div class="split-copy">
          <p class="eyebrow">Pensado para sua rotina</p>
          <h2>Seu espaço não precisa se adaptar ao móvel</h2>
          <p>É o móvel que deve ser pensado para o espaço.</p>
          <p>Cada ambiente tem medidas, circulação, necessidades de armazenamento e uma rotina diferente.</p>
          <p>Por isso, a EEP Marcenaria desenvolve móveis sob medida considerando não apenas onde serão instalados, mas também como serão usados todos os dias.</p>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Conversar sobre meu projeto</a>
        </div>
        <figure class="split-media framed-media">
          <picture>
            <source media="(max-width: 767px)" srcset="/site-profissional/marcenaria/img/homeoffice-mobile.webp" />
            <img src="/site-profissional/marcenaria/img/homeoffice-desktop.webp" alt="Home office compacto com marcenaria sob medida" width="1448" height="1086" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <section class="section services" id="servicos">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Ambientes</p>
            <h2>O que podemos criar para você</h2>
          </div>
          <p class="section-lead">Projetos residenciais e comerciais organizados para que o visitante identifique rapidamente onde a marcenaria pode ajudar.</p>
        </div>

        <div class="service-grid">
          {services.map((item, index) => (
            <article class="service-card">
              <span class="service-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{item.cta} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-dark issues" id="ideias">
      <div class="container issues-grid">
        <div>
          <p class="eyebrow">Não sabe por onde começar?</p>
          <h2>Às vezes o problema não é falta de espaço. É falta de uma solução pensada para ele.</h2>
          <ul class="issue-list">
            {issues.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <aside class="info-card info-card--light">
          <p>Você não precisa ter um desenho técnico ou todas as medidas prontas.</p>
          <strong>Envie uma foto do ambiente, uma referência e conte o que gostaria de transformar.</strong>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Enviar foto do ambiente</a>
        </aside>
      </div>
    </section>

    <section class="section reasons">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">O que faz diferença</p>
            <h2>Um móvel bonito também precisa funcionar bem</h2>
          </div>
        </div>

        <div class="reason-grid">
          {reasons.map((item) => (
            <article class="reason-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section visual-showcase section-soft">
      <div class="container split-grid">
        <figure class="split-media framed-media framed-media--elevated">
          <picture>
            <source media="(max-width: 767px)" srcset="/site-profissional/marcenaria/img/detalhe-mobile.webp" />
            <img src="/site-profissional/marcenaria/img/detalhe-desktop.webp" alt="Detalhe de ferragem e acabamento de móvel sob medida" width="1448" height="1086" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="split-copy">
          <p class="eyebrow">Acabamento</p>
          <h2>Os detalhes também fazem parte do projeto</h2>
          <p>Ferragens, alinhamento, encontros, abertura de portas e gavetas e acabamento das superfícies influenciam diretamente no uso e na percepção final do móvel.</p>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Falar sobre meu projeto</a>
        </div>
      </div>
    </section>

    <section class="section works" id="trabalhos">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Projetos que fazem parte do espaço</p>
            <h2>Ambientes pensados para organização, uso e acabamento</h2>
          </div>
          <p class="section-lead">Na marcenaria, o resultado final é a principal prova: o visitante precisa conseguir imaginar aquele tipo de solução no próprio ambiente.</p>
        </div>

        <div class="works-grid works-grid--main">
          <article class="work-feature">
            <figure class="framed-media">
              <picture>
                <source media="(max-width: 767px)" srcset="/site-profissional/marcenaria/img/closet-mobile.webp" />
                <img src="/site-profissional/marcenaria/img/closet-desktop.webp" alt="Quarto com closet e marcenaria sob medida" width="1448" height="1086" loading="lazy" decoding="async" />
              </picture>
            </figure>
            <div class="work-feature-copy">
              <h3>Projeto residencial — quarto e closet</h3>
              <p>Aproveitamento vertical, organização interna e integração visual ajudam a transformar espaço disponível em armazenamento útil.</p>
            </div>
          </article>

          <div class="work-list">
            {works.map((item) => (
              <article class="work-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <span>{item.place}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dark testimonials">
      <div class="container">
        <div class="section-head section-head--light">
          <div>
            <p class="eyebrow">Avaliações</p>
            <h2>O que nossos clientes dizem</h2>
          </div>
        </div>

        <div class="testimonial-grid">
          {testimonials.map((item) => (
            <article class="testimonial-card">
              <div class="stars">★★★★★</div>
              <p>“{item.text}”</p>
              <strong>{item.name}</strong>
            </article>
          ))}
        </div>

        <p class="demo-note">Depoimentos, nomes, avaliações e demais informações comerciais apresentados nesta demonstração são fictícios.</p>
      </div>
    </section>

    <section class="section process">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Como funciona</p>
            <h2>Do ambiente ao móvel instalado</h2>
          </div>
          <p class="section-lead">Você pode começar apenas com uma foto, uma referência ou uma ideia.</p>
        </div>

        <div class="process-grid">
          <article><span>01</span><h3>Mostre o espaço</h3><p>Envie fotos, medidas aproximadas ou referências pelo WhatsApp.</p></article>
          <article><span>02</span><h3>Entendemos a necessidade</h3><p>Conversamos sobre uso, estilo, armazenamento e características do ambiente.</p></article>
          <article><span>03</span><h3>Definimos o projeto</h3><p>São alinhadas medidas, configuração, materiais, acabamento e condições do serviço.</p></article>
          <article><span>04</span><h3>Fabricamos e instalamos</h3><p>Os móveis são produzidos e montados conforme as definições aprovadas.</p></article>
        </div>

        <div class="process-cta">
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Quero começar meu projeto</a>
        </div>
      </div>
    </section>

    <section class="section service-area section-soft" id="atendimento">
      <div class="container split-grid split-grid--reverse split-grid--top">
        <div class="split-copy">
          <p class="eyebrow">Residencial e comercial</p>
          <h2>Projetos para sua casa e para seu negócio</h2>
          <p>A EEP Marcenaria atende Curitiba e Região Metropolitana com soluções para ambientes residenciais e pequenos espaços comerciais.</p>
          <div class="area-columns">
            <div>
              <h3>Região Metropolitana</h3>
              <ul>
                {metroCities.map((city) => <li>{city}</li>)}
              </ul>
            </div>
            <div>
              <h3>Bairros de Curitiba</h3>
              <ul>
                {neighborhoods.map((n) => <li>{n}</li>)}
              </ul>
            </div>
          </div>
          <p>Outras localidades podem ser avaliadas conforme o projeto.</p>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar minha região</a>
        </div>
        <figure class="split-media framed-media">
          <picture>
            <source media="(max-width: 767px)" srcset="/site-profissional/marcenaria/img/comercial-mobile.webp" />
            <img src="/site-profissional/marcenaria/img/comercial-desktop.webp" alt="Recepção comercial com mobiliário sob medida em madeira" width="1448" height="1086" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <section class="section audience-panels">
      <div class="container panel-grid">
        <article class="audience-card audience-card--light">
          <p class="eyebrow">Para sua casa</p>
          <h2>Móveis pensados para os ambientes e a rotina da família</h2>
          <ul class="bullet-columns">
            {residentialServices.map((item) => <li>{item};</li>)}
          </ul>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Conversar sobre um projeto residencial</a>
        </article>

        <article class="audience-card audience-card--dark">
          <p class="eyebrow">Para seu negócio</p>
          <h2>Mobiliário sob medida para organizar e apresentar melhor o espaço comercial</h2>
          <ul class="bullet-columns bullet-columns--light">
            {businessServices.map((item) => <li>{item};</li>)}
          </ul>
          <a class="btn btn-secondary-light" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Solicitar projeto comercial</a>
        </article>
      </div>
    </section>

    <section class="section faq" id="faq">
      <div class="container faq-grid">
        <div>
          <p class="eyebrow">Dúvidas</p>
          <h2>Perguntas frequentes</h2>
        </div>
        <div class="faq-list">
          {faq.map((item, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-dark final-cta" id="sobre-demo">
      <div class="container final-grid">
        <div>
          <p class="eyebrow">Seu próximo ambiente</p>
          <h2>Tem um espaço que poderia funcionar melhor?</h2>
          <p>Fotografe o ambiente, envie uma referência se tiver e conte o que gostaria de organizar, guardar ou transformar.</p>
          <p>A EEP Marcenaria avalia sua ideia e orienta os próximos passos para projeto, fabricação e instalação.</p>
          <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Mostrar meu ambiente pelo WhatsApp</a>
        </div>

        <div class="final-card">
          <h3>EEP Marcenaria</h3>
          <p>Móveis planejados e projetos sob medida.</p>
          <dl>
            <div><dt>Projetos</dt><dd>Cozinhas • Quartos • Salas • Home offices • Comercial</dd></div>
            <div><dt>Região</dt><dd>Curitiba e Região Metropolitana</dd></div>
            <div><dt>Horário</dt><dd>segunda a sexta, 8h às 18h • sábado, 8h às 12h</dd></div>
            <div><dt>Pagamento</dt><dd>Pix • Débito • Crédito</dd></div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <strong>EEP Marcenaria</strong>
        <p>Móveis planejados e projetos sob medida.</p>
      </div>
      <div>
        <strong>Atendimento</strong>
