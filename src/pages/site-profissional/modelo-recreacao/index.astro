---
const whatsappUrl = "https://wa.me/5511964502997?text=Ol%C3%A1%21%20Vi%20o%20modelo%20de%20p%C3%A1gina%20para%20recrea%C3%A7%C3%A3o%20e%20eventos%20infantis%20e%20gostaria%20de%20saber%20como%20criar%20uma%20p%C3%A1gina%20semelhante%20para%20o%20meu%20neg%C3%B3cio.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Modelo demonstrativo de página profissional para recreação, festas e eventos infantis."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fff8ec" />

    <title>Modelo de página para recreação e eventos infantis</title>

    <link
      rel="canonical"
      href="https://www.estudioescritaplanejada.com.br/site-profissional/modelo-recreacao/"
    />

    <style>
      @font-face {
        font-family: "Bowlby One SC";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/bowlby-one-sc-400.ttf") format("truetype");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: "Manrope";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/manrope-400.ttf") format("truetype");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: "Manrope";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/manrope-500.ttf") format("truetype");
        font-style: normal;
        font-weight: 500;
        font-display: swap;
      }

      @font-face {
        font-family: "Manrope";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/manrope-600.ttf") format("truetype");
        font-style: normal;
        font-weight: 600;
        font-display: swap;
      }

      @font-face {
        font-family: "Manrope";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/manrope-700.ttf") format("truetype");
        font-style: normal;
        font-weight: 700;
        font-display: swap;
      }

      @font-face {
        font-family: "Manrope";
        src: url("/assets/site-profissional/modelo-recreacao/fonts/manrope-800.ttf") format("truetype");
        font-style: normal;
        font-weight: 800;
        font-display: swap;
      }
    </style>
  </head>

  <body>
    <div class="demo-strip">
      <span>Modelo demonstrativo de página profissional</span>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Quero uma página assim
      </a>
    </div>

    <header class="site-header">
      <div class="container navigation">
        <a class="brand" href="#inicio" aria-label="Voltar ao início">
          <span class="brand-symbol" aria-hidden="true">✦</span>
          <span>
            <strong>Recreação</strong>
            <small>festas & eventos</small>
          </span>
        </a>

        <nav aria-label="Navegação principal">
          <a href="#experiencias">Experiências</a>
          <a href="#eventos">Eventos</a>
          <a href="#momentos">Momentos</a>
        </nav>

        <a
          class="button button-pink header-button"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Quero um site assim
        </a>
      </div>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="container hero-layout">
          <div class="hero-copy">
            <div class="kicker">RECREAÇÃO • FESTAS • EXPERIÊNCIAS INFANTIS</div>

            <h1>
              A festa começa quando todo mundo entra na
              <em>brincadeira.</em>
            </h1>

            <p>
              Uma página profissional pode apresentar sua equipe, suas atividades
              e o cuidado por trás de cada evento — com imagens fortes, informações
              claras e um caminho direto para o WhatsApp.
            </p>

            <div class="hero-actions">
              <a
                class="button button-pink"
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Quero uma página para meu negócio →
              </a>

              <a class="button button-light" href="#experiencias">
                Ver o modelo completo
              </a>
            </div>

            <div class="support-line">
              <span>✓ Adaptada para celular</span>
              <span>✓ Apresentação clara dos serviços</span>
              <span>✓ Contato direto pelo WhatsApp</span>
            </div>
          </div>

          <div class="hero-media" aria-label="Exemplos de imagens para uma empresa de recreação">
            <figure class="hero-main">
              <img
                src="/assets/site-profissional/modelo-recreacao/1a.webp"
                alt="Profissional de recreação ao lado de duas crianças em uma festa"
                width="1448"
                height="1086"
              />
            </figure>

            <figure class="hero-card hero-card-one">
              <img
                src="/assets/site-profissional/modelo-recreacao/1e.webp"
                alt="Recreador entregando uma escultura de balão para uma criança"
                width="1448"
                height="1086"
              />
            </figure>

            <figure class="hero-card hero-card-two">
              <img
                src="/assets/site-profissional/modelo-recreacao/1h.webp"
                alt="Personagem de festa abraçando uma criança"
                width="1448"
                height="1086"
              />
            </figure>

            <div class="poster-label">Alegria que vira lembrança!</div>
            <div class="round-sticker">FESTAS<br />COM<br />IDENTIDADE</div>
          </div>
        </div>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <span>RECREAÇÃO</span>
          <span>OFICINAS CRIATIVAS</span>
          <span>PINTURA FACIAL</span>
          <span>PERSONAGENS</span>
          <span>EVENTOS ESCOLARES</span>
          <span>FESTAS INFANTIS</span>
          <span>RECREAÇÃO</span>
          <span>OFICINAS CRIATIVAS</span>
          <span>PINTURA FACIAL</span>
          <span>PERSONAGENS</span>
          <span>EVENTOS ESCOLARES</span>
          <span>FESTAS INFANTIS</span>
        </div>
      </div>

      <section id="experiencias">
        <div class="container">
          <div class="section-heading">
            <div class="section-tag">O que pode aparecer na página</div>
            <h2>Serviços apresentados com imagem, contexto e personalidade.</h2>
            <p>
              Em vez de uma lista fria, cada atividade recebe espaço para mostrar
              como funciona e o tipo de experiência que entrega.
            </p>
          </div>

          <div class="experience-list">
            <article class="experience">
              <div class="experience-number">01</div>
              <div class="experience-copy">
                <h3>Recreação e brincadeiras em grupo</h3>
                <p>
                  Jogos, desafios e atividades conduzidas de acordo com a idade,
                  o espaço e o ritmo de cada evento.
                </p>
              </div>
              <figure>
                <img
                  src="/assets/site-profissional/modelo-recreacao/1b.webp"
                  alt="Crianças participando de uma brincadeira com tecido colorido"
                  width="1448"
                  height="1086"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="experience">
              <div class="experience-number">02</div>
              <div class="experience-copy">
                <h3>Oficinas criativas</h3>
                <p>
                  Atividades práticas que estimulam a imaginação e dão às crianças
                  algo especial para criar, experimentar e levar consigo.
                </p>
              </div>
              <figure>
                <img
                  src="/assets/site-profissional/modelo-recreacao/1c.webp"
                  alt="Criança participando de uma oficina criativa de slime"
                  width="1448"
                  height="1086"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="experience">
              <div class="experience-number">03</div>
              <div class="experience-copy">
                <h3>Pintura facial e caracterização</h3>
                <p>
                  Cores, detalhes e cuidado para transformar a brincadeira em
                  uma experiência ainda mais envolvente.
                </p>
              </div>
              <figure>
                <img
                  src="/assets/site-profissional/modelo-recreacao/1d.webp"
                  alt="Criança sorrindo durante uma pintura facial colorida"
                  width="1448"
                  height="1086"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="experience">
              <div class="experience-number">04</div>
              <div class="experience-copy">
                <h3>Programações para escolas e espaços infantis</h3>
                <p>
                  Recreação em ambientes preparados para receber grupos, famílias
                  e diferentes faixas etárias.
                </p>
              </div>
              <figure>
                <img
                  src="/assets/site-profissional/modelo-recreacao/1f.webp"
                  alt="Equipe conduzindo atividades com crianças em um espaço infantil"
                  width="1448"
                  height="1086"
                  loading="lazy"
                />
              </figure>
            </article>
          </div>
        </div>
      </section>

      <section class="events-section" id="eventos">
        <div class="container events-layout">
          <div class="events-copy">
            <div class="section-tag light-tag">Festas que pedem algo especial</div>

            <h2>Personagens, histórias e momentos de encantamento.</h2>

            <p>
              Uma seção de destaque pode apresentar atrações temáticas, entradas
              especiais e experiências pensadas para aproximar as crianças da cena.
            </p>

            <p>
              O texto explica o diferencial do serviço sem exagero comercial,
              enquanto as imagens mostram a qualidade, o cuidado e a atmosfera
              do trabalho.
            </p>

            <ul>
              <li>festas infantis e aniversários;</li>
              <li>ações em escolas e condomínios;</li>
              <li>eventos de empresas e espaços comerciais;</li>
              <li>datas comemorativas e programações temáticas.</li>
            </ul>

            <a
              class="button button-pink"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Quero apresentar melhor meu trabalho →
            </a>
          </div>

          <div class="feature-ticket">
            <figure>
              <img
                src="/assets/site-profissional/modelo-recreacao/1g.webp"
                alt="Personagem temático interagindo com crianças durante uma festa"
                width="1448"
                height="1086"
                loading="lazy"
              />
            </figure>

            <div class="ticket-caption">
              <strong>Uma página com a cara do seu negócio</strong>
              <span>IMAGENS • TEXTO • IDENTIDADE • WHATSAPP</span>
            </div>
          </div>
        </div>
      </section>

      <section id="momentos">
        <div class="container moments-layout">
          <div class="moments-image">
            <figure>
              <img
                src="/assets/site-profissional/modelo-recreacao/1h.webp"
                alt="Personagem temático demonstrando carinho durante uma festa infantil"
                width="1448"
                height="1086"
                loading="lazy"
              />
            </figure>
          </div>

          <div class="moments-copy">
            <div class="section-tag">Prova visual e confiança</div>
            <h2>As imagens mostram o que uma descrição sozinha não consegue.</h2>
            <p>
              Expressões, interação, organização e atenção às crianças ajudam a
              família a entender o tipo de experiência oferecida antes mesmo do
              primeiro contato.
            </p>

            <blockquote>
              “Exemplo de depoimento: as crianças participaram do começo ao fim,
              e a equipe conduziu tudo com carinho, energia e organização.”
            </blockquote>

            <small>Depoimento ilustrativo para o modelo demonstrativo.</small>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="container faq-layout">
          <div class="section-heading">
            <div class="section-tag">Informações que ajudam a decidir</div>
            <h2>Dúvidas respondidas antes do orçamento.</h2>
            <p>
              Uma boa página reduz perguntas repetidas e deixa o contato pelo
              WhatsApp mais preparado.
            </p>
          </div>

          <div class="faq-list">
            <details open>
              <summary>Quais tipos de evento podem ser atendidos?</summary>
              <p>
                A página pode informar festas, escolas, condomínios, empresas,
                espaços comerciais e outras programações compatíveis com o serviço.
              </p>
            </details>

            <details>
              <summary>As atividades são adaptadas por idade?</summary>
              <p>
                O texto pode explicar como a programação muda conforme a faixa
                etária, a quantidade de crianças e o tempo disponível.
              </p>
            </details>

            <details>
              <summary>Como funciona o orçamento?</summary>
              <p>
                O botão leva diretamente ao WhatsApp, onde o cliente informa data,
                local, público e atrações desejadas.
              </p>
            </details>

            <details>
              <summary>Posso usar minhas próprias fotos?</summary>
              <p>
                Sim. Fotografias reais são organizadas dentro do design sem
                deformação e ajudam a construir uma apresentação mais confiável.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section class="final-section">
        <div class="container">
          <div class="final-box">
            <div class="section-tag">Este modelo pode ganhar a sua identidade</div>

            <h2>
              Seu trabalho já cria momentos especiais. A página precisa mostrar isso.
            </h2>

            <p>
              O Estúdio organiza suas informações, escreve os textos, cria o visual,
              adapta para celular e publica a página pronta para você divulgar.
            </p>

            <a
              class="button button-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Conversar com o Estúdio no WhatsApp
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-content">
        <span>Modelo demonstrativo para recreação e eventos infantis.</span>
        <span>Estúdio Escrita Planejada</span>
      </div>
    </footer>

    <a
      class="mobile-whatsapp"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Quero uma página assim
    </a>
  </body>
</html>

<style is:global>
  :root {
    --navy: #09224c;
    --pink: #ff336f;
    --yellow: #ffd135;
    --cyan: #23bed0;
    --violet: #8a5cff;
    --cream: #fff8ec;
    --paper: #fffdf8;
    --ink: #182132;
    --muted: #657084;
    --line: rgba(9, 34, 76, 0.14);
    --shadow: 0 24px 64px rgba(9, 34, 76, 0.16);
    --max-width: 1200px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
    color: var(--ink);
    background:
      linear-gradient(rgba(9, 34, 76, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(9, 34, 76, 0.035) 1px, transparent 1px),
      var(--cream);
    background-size: 28px 28px;
    font-family: "Manrope", sans-serif;
    line-height: 1.65;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(calc(100% - 36px), var(--max-width));
    margin-inline: auto;
  }

  .demo-strip {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 7px 16px;
    color: white;
    background: var(--navy);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .demo-strip a {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(9, 34, 76, 0.08);
    background: rgba(255, 248, 236, 0.9);
    backdrop-filter: blur(16px);
  }

  .navigation {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--navy);
  }

  .brand-symbol {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 3px solid var(--navy);
    border-radius: 50%;
    color: var(--navy);
    background: var(--yellow);
    box-shadow: 5px 5px 0 var(--pink);
    font-size: 1.35rem;
  }

  .brand span:last-child {
    display: grid;
    line-height: 1.05;
  }

  .brand strong {
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .brand small {
    color: var(--pink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    gap: 28px;
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 800;
  }

  nav a:hover {
    color: var(--pink);
  }

  .button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 24px;
    border: 2px solid transparent;
    border-radius: 999px;
    font-weight: 800;
    text-align: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-pink {
    color: white;
    background: var(--pink);
    box-shadow: 0 14px 34px rgba(255, 51, 111, 0.28);
  }

  .button-light {
    color: var(--navy);
    border-color: rgba(9, 34, 76, 0.13);
    background: white;
  }

  .button-whatsapp {
    color: white;
    background: #16b857;
    box-shadow: 0 14px 34px rgba(22, 184, 87, 0.26);
  }

  h1,
  h2,
  h3 {
    max-width: 100%;
    margin: 0;
    color: var(--navy);
    font-family: "Bowlby One SC", sans-serif;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 84px 0 92px;
    background:
      radial-gradient(circle at 90% 12%, rgba(255, 209, 53, 0.38), transparent 20%),
      radial-gradient(circle at 7% 35%, rgba(35, 190, 208, 0.24), transparent 23%);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: 54px;
    align-items: center;
  }

  .kicker,
  .section-tag {
    color: var(--pink);
    font-size: 0.79rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kicker {
    width: fit-content;
    margin-bottom: 28px;
    padding: 9px 15px;
    border: 2px solid var(--navy);
    border-radius: 999px;
    color: var(--navy);
    background: var(--yellow);
    box-shadow: 6px 6px 0 var(--navy);
    transform: rotate(-1deg);
  }

  h1 {
    max-width: 690px;
    font-size: clamp(3.6rem, 7.3vw, 7.5rem);
    line-height: 0.92;
    text-wrap: balance;
  }

  h1 em {
    color: var(--pink);
    font-style: normal;
    text-shadow: 5px 5px 0 white;
  }

  .hero-copy > p {
    max-width: 620px;
    margin: 28px 0 30px;
    color: #3d475b;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .support-line {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 20px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .hero-media {
    position: relative;
    min-height: 650px;
    padding: 36px 20px 38px 74px;
  }

  .hero-main {
    width: min(100%, 560px);
    margin: 28px 0 0 auto;
    overflow: hidden;
    border: 8px solid white;
    border-radius: 44% 44% 32px 32px;
    background: white;
    box-shadow: var(--shadow);
    transform: rotate(2deg);
  }

  .hero-card {
    position: absolute;
    z-index: 4;
    width: 205px;
    margin: 0;
    padding: 9px 9px 30px;
    background: white;
    box-shadow: 0 18px 42px rgba(9, 34, 76, 0.22);
  }

  .hero-card-one {
    left: 0;
    top: 0;
    transform: rotate(-7deg);
  }

  .hero-card-two {
    right: -10px;
    top: 75px;
    transform: rotate(7deg);
  }

  .poster-label {
    position: absolute;
    z-index: 7;
    right: 0;
    bottom: 60px;
    max-width: 300px;
    padding: 15px 20px;
    border: 3px solid var(--navy);
    color: var(--navy);
    background: var(--yellow);
    box-shadow: 8px 8px 0 var(--pink);
    font-family: "Bowlby One SC", sans-serif;
    font-size: 1.2rem;
    line-height: 1.08;
    transform: rotate(-4deg);
  }

  .round-sticker {
    position: absolute;
    z-index: 8;
    left: 12px;
    bottom: 22px;
    width: 116px;
    height: 116px;
    display: grid;
    place-items: center;
    border: 4px solid var(--navy);
    border-radius: 50%;
    color: white;
    background: var(--cyan);
    box-shadow: 7px 7px 0 var(--navy);
    font-family: "Bowlby One SC", sans-serif;
    font-size: 0.76rem;
    line-height: 1.1;
    text-align: center;
    transform: rotate(-9deg);
  }

  .marquee {
    margin-inline: -12px;
    overflow: hidden;
    border-block: 4px solid white;
    color: white;
    background: var(--navy);
    transform: rotate(-0.5deg);
  }

  .marquee-track {
    width: max-content;
    display: flex;
