---
import LegalLinks from '../../components/legal/LegalLinks.astro';
import StandalonePageLayout from '../../layouts/StandalonePageLayout.astro';
import '../../styles/enquanto.css';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#organization",
      "name": "Enquanto Ele Age",
      "url": "https://www.estudioescritaplanejada.com.br/enquanto/",
      "email": "enquantoeleage@gmail.com",
      "logo": "https://www.estudioescritaplanejada.com.br/assets/enquanto-ele-age/img/logo.png",
      "image": "https://www.estudioescritaplanejada.com.br/assets/enquanto-ele-age/img/og-image.jpg",
      "sameAs": [
        "https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#website",
      "url": "https://www.estudioescritaplanejada.com.br/enquanto/",
      "name": "Enquanto Ele Age",
      "description": "Louvores, orações e música cristã para casa, rotina, paz e descanso.",
      "inLanguage": "pt-BR",
      "publisher": {
        "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#webpage",
      "url": "https://www.estudioescritaplanejada.com.br/enquanto/",
      "name": "Enquanto Ele Age | Louvores para Casa, Paz e Descanso",
      "description": "Louvores, orações e música cristã para deixar tocando em casa, acompanhar sua rotina, desacelerar a mente e descansar na presença de Deus.",
      "isPartOf": {
        "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#website"
      },
      "about": {
        "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#organization"
      },
      "inLanguage": "pt-BR"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.estudioescritaplanejada.com.br/enquanto/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Preciso pagar para ouvir os conteúdos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. Os louvores, vídeos, lives e playlists públicas podem ser assistidos gratuitamente no YouTube."
          }
        },
        {
          "@type": "Question",
          "name": "Posso deixar os vídeos tocando na televisão?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Muitos conteúdos são longos e foram pensados para acompanhar a casa, a rotina, o trabalho e o descanso."
          }
        },
        {
          "@type": "Question",
          "name": "O site reproduz os vídeos diretamente?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Alguns conteúdos selecionados ficam incorporados ao site. Você também pode abrir qualquer vídeo ou playlist diretamente no YouTube."
          }
        },
        {
          "@type": "Question",
          "name": "O que é o Clube Enquanto Ele Age?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É a área de membros do canal. Além de apoiar o projeto, os membros recebem benefícios e materiais exclusivos de acordo com o nível escolhido."
          }
        },
        {
          "@type": "Question",
          "name": "Os materiais do Clube podem ser baixados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os materiais disponíveis para o nível Casa em Paz são entregues em formatos próprios para leitura, impressão ou uso digital."
          }
        },
        {
          "@type": "Question",
          "name": "Posso cancelar minha assinatura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. A assinatura do Clube é administrada pelo YouTube e pode ser cancelada pela própria plataforma."
          }
        }
      ]
    }
  ]
};
---

<StandalonePageLayout
  title="Enquanto Ele Age | Louvores para Casa, Paz e Descanso"
  description="Louvores, orações e música cristã para deixar tocando em casa, acompanhar sua rotina, desacelerar a mente e descansar na presença de Deus."
  canonicalPath="/enquanto/"
  author="Enquanto Ele Age"
  siteName="Enquanto Ele Age"
  image="/assets/enquanto-ele-age/img/og-image.jpg"
  imageAlt="Mesa em jardim com Bíblia, caderno e caneca, acompanhada da mensagem Curta, compartilhe, espalhe a palavra"
  socialDescription="Música cristã, oração e louvores contínuos para acompanhar sua casa, sua rotina e seus momentos de descanso."
  twitterDescription="Louvores e música cristã para acompanhar a casa, a rotina, o trabalho e o descanso."
  themeColor="#071821"
  colorScheme="dark light"
  bodyDataPage="enquanto-ele-age"
  faviconSvg="/assets/enquanto-ele-age/favicon.svg"
  faviconPng="/assets/enquanto-ele-age/favicon-48.png"
  appleTouchIcon="/assets/enquanto-ele-age/apple-touch-icon.png"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=League+Spartan:wght@600;700;800&amp;display=swap"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </Fragment>

<a class="skip-link" href="#conteudo">Ir para o conteúdo principal</a>
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="Enquanto Ele Age — início">
      <img src="/assets/enquanto-ele-age/img/logo.png" alt="" width="42" height="42">
      <span class="brand-copy"><strong>Enquanto Ele Age</strong><span>Momentos de paz com Deus</span></span>
    </a>
    <nav class="nav" id="nav" aria-label="Navegação principal">
      <a href="#inicio">Início</a>
      <a href="#ouca-agora">Ouça agora</a>
      <a href="#desacelerar">Um Momento para Desacelerar</a>
      <a href="#clube">Clube</a>
      <a href="#materiais">Materiais</a>
      <a href="#sobre">Sobre</a>
    </nav>
    <a class="btn btn-primary header-cta" href="https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ" target="_blank" rel="noopener noreferrer">Assistir no YouTube</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu"><span></span><span></span><span></span></button>
  </div>
</header>

<main id="conteudo">
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow hero-kicker">Música cristã para a vida real</p>
        <h1 id="hero-title">Louvores para deixar tocando.<span>Paz para deixar ficar.</span></h1>
        <p class="hero-lead">Música cristã, oração e louvores contínuos para acompanhar sua casa, sua rotina e os momentos em que o coração precisa desacelerar.</p>
        <p>Coloque para tocar enquanto você organiza a casa, trabalha, começa o dia ou se prepara para descansar. Sem pressa, sem exigência e sem precisar encontrar as palavras certas.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#ouca-agora">Ouvir agora</a>
          <a class="btn btn-secondary" href="#clube">Conhecer o Clube</a>
        </div>
        <p class="hero-support">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 14.5v-7Z" stroke="currentColor" stroke-width="1.8"/><path d="m10 9 4 2.5-4 2.5V9Z" fill="currentColor"/><path d="M8 20h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Conteúdos longos para ouvir no celular, no computador ou deixar tocando na TV.
        </p>
      </div>
      <div class="hero-media reveal">
        <div class="hero-frame">
          <img src="/assets/enquanto-ele-age/img/hero.webp" alt="Mulher descansando à noite com a identidade visual do Enquanto Ele Age" width="1200" height="630" fetchpriority="high" decoding="async">
        </div>
        <div class="hero-badge">Casa<br>Paz<br>Descanso</div>
      </div>
    </div>
  </section>

  <section class="listen" id="ouca-agora" aria-labelledby="listen-title">
    <div class="container">
      <div class="listen-head reveal">
        <div>
          <p class="eyebrow">Ouça agora</p>
          <h2 class="section-title" id="listen-title">Escolha o que você precisa <em>neste momento</em></h2>
        </div>
        <p class="section-intro">Há dias em que a casa precisa de paz. Em outros, é a mente que não consegue parar. Escolha um ambiente, aperte o play e permita que o louvor acompanhe o que você está vivendo.</p>
      </div>

      <article class="listen-category reveal" aria-labelledby="blindagem-title">
        <div class="category-head">
          <div>
            <div class="category-index">Categoria 01 · Blindagem do Lar</div>
            <h3 id="blindagem-title">Louvores e orações para sua casa</h3>
          </div>
          <div class="category-copy">
            <p>Três conteúdos selecionados para acompanhar a rotina doméstica, a oração pela família e os momentos em que você deseja trazer mais serenidade para dentro do lar.</p>
            <p>Não é preciso ter uma casa perfeita. Comece pelo ambiente possível, pelas tarefas de hoje e por alguns minutos de presença.</p>
          </div>
        </div>
        <div class="video-grid">
          <div class="video-shell"><a class="video-card" data-video-id="QC6NhA87cAk" href="https://youtube.com/live/QC6NhA87cAk?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Blindagem do Lar, conteúdo 1"><img src="https://i.ytimg.com/vi/QC6NhA87cAk/hqdefault.jpg" alt="Miniatura do conteúdo Blindagem do Lar 1" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Blindagem do Lar · Conteúdo 1</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="4H9fVVrlhes" href="https://youtube.com/live/4H9fVVrlhes?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Blindagem do Lar, conteúdo 2"><img src="https://i.ytimg.com/vi/4H9fVVrlhes/hqdefault.jpg" alt="Miniatura do conteúdo Blindagem do Lar 2" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Blindagem do Lar · Conteúdo 2</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="mA0vsBzEKjM" href="https://youtube.com/live/mA0vsBzEKjM?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Blindagem do Lar, conteúdo 3"><img src="https://i.ytimg.com/vi/mA0vsBzEKjM/hqdefault.jpg" alt="Miniatura do conteúdo Blindagem do Lar 3" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Blindagem do Lar · Conteúdo 3</span></a></div>
        </div>
        <div class="category-actions"><a class="btn" href="https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ/playlists" target="_blank" rel="noopener noreferrer">Ver a playlist Blindagem do Lar</a></div>
      </article>

      <article class="listen-category reveal" aria-labelledby="dormir-title">
        <div class="category-head">
          <div>
            <div class="category-index">Categoria 02 · Música Cristã para Dormir</div>
            <h3 id="dormir-title">Diminua o ritmo e entregue o dia</h3>
          </div>
          <div class="category-copy">
            <p>Louvores longos e suaves para ouvir antes de dormir, deixar tocando durante a noite ou acompanhar aquele momento em que o corpo está cansado, mas a mente continua cheia.</p>
            <p>Apague as luzes mais fortes, afaste o celular e permita que a música conduza a casa para um ritmo mais tranquilo.</p>
          </div>
        </div>
        <div class="video-grid">
          <div class="video-shell"><a class="video-card" data-video-id="RJXCbFxt2qY" href="https://youtube.com/live/RJXCbFxt2qY?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Dormir, conteúdo 1"><img src="https://i.ytimg.com/vi/RJXCbFxt2qY/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Dormir 1" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Música Cristã para Dormir · Conteúdo 1</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="ZxNnqLhxCDw" href="https://youtube.com/live/ZxNnqLhxCDw?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Dormir, conteúdo 2"><img src="https://i.ytimg.com/vi/ZxNnqLhxCDw/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Dormir 2" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Música Cristã para Dormir · Conteúdo 2</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="pkmqnA6HMCk" href="https://youtube.com/live/pkmqnA6HMCk?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Dormir, conteúdo 3"><img src="https://i.ytimg.com/vi/pkmqnA6HMCk/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Dormir 3" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Música Cristã para Dormir · Conteúdo 3</span></a></div>
        </div>
        <div class="category-actions"><a class="btn" href="https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ/playlists" target="_blank" rel="noopener noreferrer">Ver a playlist para dormir</a></div>
      </article>

      <article class="listen-category reveal" aria-labelledby="manha-title">
        <div class="category-head">
          <div>
            <div class="category-index">Categoria 03 · Música Cristã para Começar o Dia</div>
            <h3 id="manha-title">Antes da pressa, comece com paz</h3>
          </div>
          <div class="category-copy">
            <p>Louvores para acompanhar o despertar, o café, a preparação da casa e os primeiros pensamentos da manhã.</p>
            <p>Você não precisa começar o dia com todas as respostas. Pode começar apenas lembrando que não está sozinho e que Deus continua presente no caminho.</p>
          </div>
        </div>
        <div class="video-grid">
          <div class="video-shell"><a class="video-card" data-video-id="moL5eNV7QGE" href="https://youtube.com/live/moL5eNV7QGE?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Começar o Dia, conteúdo 1"><img src="https://i.ytimg.com/vi/moL5eNV7QGE/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Começar o Dia 1" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Começar o Dia · Conteúdo 1</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="eYPQ55yXVXY" href="https://youtube.com/live/eYPQ55yXVXY?feature=share" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Começar o Dia, conteúdo 2"><img src="https://i.ytimg.com/vi/eYPQ55yXVXY/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Começar o Dia 2" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Começar o Dia · Conteúdo 2</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="e4GHyOq2I8s" href="https://youtu.be/e4GHyOq2I8s" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Música Cristã para Começar o Dia, conteúdo 3"><img src="https://i.ytimg.com/vi/e4GHyOq2I8s/hqdefault.jpg" alt="Miniatura do conteúdo Música Cristã para Começar o Dia 3" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Começar o Dia · Conteúdo 3</span></a></div>
        </div>
        <div class="category-actions"><a class="btn" href="https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ/playlists" target="_blank" rel="noopener noreferrer">Ver a playlist Manhã com Deus</a></div>
      </article>

      <article class="listen-category reveal" aria-labelledby="foco-title">
        <div class="category-head">
          <div>
            <div class="category-index">Categoria 04 · Foco e Fé</div>
            <h3 id="foco-title">Uma companhia para trabalhar e continuar</h3>
          </div>
          <div class="category-copy">
            <p>Música cristã para estudar, trabalhar, organizar a casa, escrever, cuidar de tarefas ou simplesmente permanecer concentrado sem abrir mão de um ambiente de fé.</p>
            <p>Conteúdos longos, discretos e preparados para acompanhar a rotina sem interromper o que você precisa fazer.</p>
          </div>
        </div>
        <div class="video-grid">
          <div class="video-shell"><a class="video-card" data-video-id="8ims3nnmDKs" href="https://www.youtube.com/watch?v=8ims3nnmDKs" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Foco e Fé, conteúdo 1"><img src="https://i.ytimg.com/vi/8ims3nnmDKs/hqdefault.jpg" alt="Miniatura do conteúdo Foco e Fé 1" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Foco e Fé · Conteúdo 1</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="n-9obKX83UU" href="https://www.youtube.com/watch?v=n-9obKX83UU" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Foco e Fé, conteúdo 2"><img src="https://i.ytimg.com/vi/n-9obKX83UU/hqdefault.jpg" alt="Miniatura do conteúdo Foco e Fé 2" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Foco e Fé · Conteúdo 2</span></a></div>
          <div class="video-shell"><a class="video-card" data-video-id="C37FjqcOXSQ" href="https://www.youtube.com/watch?v=C37FjqcOXSQ" target="_blank" rel="noopener noreferrer" aria-label="Reproduzir Foco e Fé, conteúdo 3"><img src="https://i.ytimg.com/vi/C37FjqcOXSQ/hqdefault.jpg" alt="Miniatura do conteúdo Foco e Fé 3" width="480" height="360" loading="lazy"><span class="play-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="video-label">Foco e Fé · Conteúdo 3</span></a></div>
        </div>
        <div class="category-actions"><a class="btn" href="https://www.youtube.com/channel/UCN23MzCBXHS5ieyNNAHLoLQ/playlists" target="_blank" rel="noopener noreferrer">Ver a playlist Foco e Fé</a></div>
      </article>
    </div>
  </section>

  <section class="split-section manifesto" id="manifesto" aria-labelledby="manifesto-title">
    <div class="container split-grid">
      <div class="media-card reveal">
        <img src="/assets/enquanto-ele-age/img/manifesto.webp" alt="Mulher sentada na sala ao lado da frase Deus está cuidando" width="1200" height="630" loading="lazy" decoding="async">
      </div>
      <div class="split-copy reveal">
        <p class="eyebrow">Manifesto</p>
        <h2 class="section-title" id="manifesto-title">A vida não para. Mas a paz pode entrar nela.</h2>
        <p>O Enquanto Ele Age foi criado para os dias reais.</p>
        <p>Para a manhã que começa antes de você estar pronto. Para a casa que precisa de cuidado. Para o trabalho que ainda não terminou. Para a noite em que o corpo pede descanso, mas o coração continua tentando resolver tudo.</p>
        <p>Aqui, o louvor não exige um cenário perfeito.</p>
        <p>Ele pode tocar enquanto você prepara o café, organiza um cômodo, cuida de alguém, trabalha, respira ou apenas permanece em silêncio.</p>
        <p>Este é um ambiente para lembrar que Deus continua presente mesmo quando nada parece mudar.</p>
        <p>Você não precisa carregar tudo sozinho.</p>
        <div class="manifesto-statement">Enquanto você vive, espera e continua, Ele age.</div>
      </div>
    </div>
  </section>

  <section class="split-section desacelerar" id="desacelerar" aria-labelledby="desacelerar-title">
    <div class="container split-grid reverse">
      <div class="split-copy reveal">
        <p class="eyebrow">Conteúdo útil para a vida que acontece fora da tela</p>
        <h2 class="section-title" id="desacelerar-title">Um Momento para <em>Desacelerar</em></h2>
        <p class="section-intro">Nem sempre precisamos de mais informação. Às vezes, precisamos de clareza, direção e alguns minutos para reorganizar o que está acontecendo por dentro.</p>
        <p>Nesta série, fé e vida prática caminham juntas em vídeos sobre:</p>
        <ul class="topic-list">
          <li>descanso emocional</li>
          <li>organização da rotina</li>
          <li>cuidado com a casa</li>
          <li>recomeços</li>
          <li>culpa e sobrecarga</li>
          <li>espera</li>
          <li>presença de Deus nos dias comuns</li>
