const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Estúdio Escrita Planejada',
      url: siteUrl,
      email: 'estudioescritaplanejada@gmail.com',
