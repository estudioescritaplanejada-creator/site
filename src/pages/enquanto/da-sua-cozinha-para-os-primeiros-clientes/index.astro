    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Estúdio Escrita Planejada',
      inLanguage: 'pt-BR',
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalUrl,
      name: 'Da Sua Cozinha para os Primeiros Clientes',
      description,
