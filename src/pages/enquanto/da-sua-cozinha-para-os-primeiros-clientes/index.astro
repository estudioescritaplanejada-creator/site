const currentYear = new Date().getFullYear();
---

<StandalonePageLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  author="Estúdio Escrita Planejada"
  siteName="Enquanto Ele Age"
  image="/assets/enquanto/da-sua-cozinha/og-image.webp"
  imageAlt="Apresentação do kit digital Da Sua Cozinha para os Primeiros Clientes"
  socialDescription="Você já sabe cozinhar. Organize produto, preço, apresentação, divulgação e atendimento para começar a transformar sua cozinha em uma oferta."
  twitterDescription="Organize o que vender, quanto cobrar, como apresentar, divulgar e receber pedidos de comida feita em casa."
  themeColor="#17324D"
  colorScheme="light"
  bodyClass="cozinha-page"
  bodyDataPage="da-sua-cozinha"
  faviconSvg="/assets/enquanto-ele-age/favicon.svg"
  faviconPng="/assets/enquanto-ele-age/favicon-48.png"
  appleTouchIcon="/assets/enquanto-ele-age/apple-touch-icon.png"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/assets/enquanto/da-sua-cozinha/v2/hero-v2-desktop.webp"
      type="image/webp"
      media="(min-width: 43.01rem)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/enquanto/da-sua-cozinha/v2/hero-v2-mobile.webp"
      type="image/webp"
      media="(max-width: 43rem)"
      fetchpriority="high"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    ></script>

    <script is:inline>
      (() => {
        const analyticsConsentKey = 'eep_analytics_consent';
        const analyticsConsentVersionKey = 'eep_analytics_consent_version';
        const analyticsConsentVersion = '2026-07-31-v1';
        const hotmartConsentKey = 'eep_hotmart_analytics_consent';
        const hotmartConsentVersionKey =
          'eep_hotmart_analytics_consent_version';
        const hotmartConsentVersion = '2026-08-20-v1';

        const readStorage = (key) => {
          try {
            return window.localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const saveHotmartChoice = (choice) => {
          try {
            window.localStorage.setItem(hotmartConsentKey, choice);
            window.localStorage.setItem(
              hotmartConsentVersionKey,
              hotmartConsentVersion,
            );
          } catch {
            // Sem persistência: o rastreamento permanece desativado.
          }
        };

        const hasCurrentHotmartChoice = () => {
          if (
            readStorage(hotmartConsentVersionKey) !== hotmartConsentVersion
          ) {
            return false;
          }

          const choice = readStorage(hotmartConsentKey);
          return choice === 'granted' || choice === 'denied';
        };

        const loadHotmartAnalytics = () => {
          if (
            readStorage(analyticsConsentKey) !== 'granted' ||
            readStorage(analyticsConsentVersionKey) !== analyticsConsentVersion
          ) {
            return;
          }

          if (
            readStorage(hotmartConsentVersionKey) !== hotmartConsentVersion ||
            readStorage(hotmartConsentKey) !== 'granted'
          ) {
            return;
          }

          if (document.getElementById('hotmart_launcher_script')) return;

          const script = document.createElement('script');
          script.id = 'hotmart_launcher_script';

          script.textContent = `(function(l,a,u,n,c,h,e,r){l['HotmartLauncherObject']=c;l[c]=l[c]||function(){
(l[c].q=l[c].q||[]).push(arguments)},l[c].l=1*new Date();h=a.createElement(u),
e=a.getElementsByTagName(u)[0];h.async=1;h.src=n;e.parentNode.insertBefore(h,e)
})(window,document,'script','//launcher.hotmart.com/launcher.js','hot');

hot('account','043c4a5a-6eb1-3ccb-98aa-564a403a46f9');`;

          document.head.appendChild(script);
        };

        if (
          hasCurrentHotmartChoice() &&
          readStorage(hotmartConsentKey) === 'granted'
        ) {
          loadHotmartAnalytics();
        }

        const configureHotmartConsent = () => {
          const banner = document.getElementById('eep-analytics-consent');
          const description = document.getElementById(
            'eep-analytics-description',
          );
          const acceptButton = document.getElementById('eep-analytics-accept');
          const rejectButton = document.getElementById('eep-analytics-reject');
          const settingsButton = document.getElementById(
            'eep-analytics-settings',
          );

          if (
            !banner ||
            !description ||
            !acceptButton ||
            !rejectButton ||
            !settingsButton
          ) {
            return;
          }

          description.innerHTML =
            'Usamos armazenamento local para lembrar sua escolha. Com sua autorização, o Google Analytics mede o uso do site e, somente nesta página de produto, o Hotmart Analytics mede a jornada até o checkout. Consulte <a href="/cookies/">Cookies</a> e <a href="/privacidade/">Privacidade</a>. Você pode aceitar ou recusar.';

          acceptButton.addEventListener('click', () => {
            saveHotmartChoice('granted');
            window.setTimeout(loadHotmartAnalytics, 0);
          });

          rejectButton.addEventListener('click', () => {
            saveHotmartChoice('denied');
          });

          if (!hasCurrentHotmartChoice()) {
            banner.hidden = false;
            settingsButton.hidden = true;
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener(
            'DOMContentLoaded',
            configureHotmartConsent,
            { once: true },
          );
        } else {
          configureHotmartConsent();
        }
      })();
    </script>
  </Fragment>

  <a class="cozinha-skip" href="#conteudo">
    Ir para o conteúdo principal
  </a>

  <header class="cozinha-header">
    <div class="cozinha-container cozinha-header__inner">
      <a
        class="cozinha-brand"
        href="/enquanto/"
        aria-label="Enquanto Ele Age — página principal"
      >
        <img
          src="/assets/enquanto-ele-age/img/logo.png"
          alt=""
          width="42"
          height="42"
        />
        <span>
          <strong>Enquanto Ele Age</strong>
          <small>Materiais para a vida possível</small>
        </span>
      </a>

      <a
        class="cozinha-header__cta"
        href={checkoutUrl}
        data-analytics-event="commercial_cta_click"
        data-cta-type="hotmart_checkout_header"
        data-cta-label="Começar por R$ 77,00"
      >
        Começar por R$ 77,00
      </a>
    </div>
  </header>

  <main id="conteudo">
    <nav
      class="cozinha-breadcrumb cozinha-container"
      aria-label="Caminho da página"
    >
      <a href="/enquanto/">Enquanto Ele Age</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">
        Da Sua Cozinha para os Primeiros Clientes
      </span>
    </nav>

    <section
      class="cozinha-hero cozinha-hero--v2"
      aria-labelledby="cozinha-hero-title"
    >
      <div class="cozinha-hero__media" aria-hidden="true"></div>
      <div class="cozinha-hero__shade" aria-hidden="true"></div>

      <div class="cozinha-container cozinha-hero__stage">
        <div class="cozinha-hero__content cozinha-hero__content--v2">
          <p class="cozinha-product-name">
            Da Sua Cozinha para os Primeiros Clientes
          </p>

          <h1 id="cozinha-hero-title">
            Você já sabe fazer o que as pessoas pedem repetido.
            <span>Só falta transformar isso em pedido de verdade.</span>
          </h1>

          <p class="cozinha-hero__lead">
            Aquele bolo que some da bandeja em 20 minutos. Aquele salgado que
            já ouviu “você deveria vender isso” mais de uma vez. A parte difícil,
            saber fazer bem, você já resolveu.
          </p>

          <p class="cozinha-hero__lead cozinha-hero__lead--product">
            <strong>Da Sua Cozinha para os Primeiros Clientes</strong>
            organiza o resto: o que vender primeiro, quanto cobrar, como
            apresentar, onde divulgar e como responder quando o pedido chegar.
          </p>

          <div class="cozinha-hero__conversion">
            <div class="cozinha-price-summary">
              <strong>R$ 77,00</strong>
              <span>Pagamento único · acesso vitalício</span>
            </div>

            <a
              class="cozinha-button cozinha-button--primary"
              href={checkoutUrl}
              data-analytics-event="commercial_cta_click"
              data-cta-type="hotmart_checkout_hero"
              data-cta-label="Quero começar agora por R$ 77,00"
            >
              Quero começar agora
            </a>
          </div>

          <ul class="cozinha-trust-list" aria-label="Condições da compra">
            <li>Compra e acesso pela Hotmart</li>
            <li>Pagamento único</li>
            <li>Leitura no celular e no computador</li>
          </ul>
        </div>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-v2-inaction"
      aria-labelledby="cozinha-inaction-title"
    >
      <div class="cozinha-container cozinha-v2-inaction__grid">
        <div>
          <p class="cozinha-kicker">O custo do improviso</p>

          <h2 id="cozinha-inaction-title">
            O que custa não organizar isso agora
          </h2>
        </div>

        <div class="cozinha-v2-inaction__copy">
          <p>
            Cada mês sem isso resolvido não é um mês parado: é um mês
            vendendo no improviso, cobrando errado ou nem cobrando,
            perdendo pedido por não saber responder rápido.
          </p>

          <p class="cozinha-v2-inaction__echo">
            “Vou resolver depois” geralmente quer dizer
            <strong>“vou continuar cobrando errado por mais tempo”.</strong>
          </p>
        </div>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-v2-transformation"
      aria-labelledby="cozinha-transformation-title"
    >
      <div class="cozinha-container">
        <div class="cozinha-v2-section-intro">
          <p class="cozinha-kicker">Pense na diferença</p>

          <h2 id="cozinha-transformation-title">
            O produto já pode ser bom. O que muda é a organização.
          </h2>

          <p class="cozinha-section__lead">
            Você não precisa transformar sua cozinha em uma empresa enorme.
            Precisa deixar claras as decisões que hoje ainda dependem do improviso.
          </p>
        </div>

        <figure class="cozinha-v2-photo cozinha-v2-photo--wide">
          <img
            src="/assets/enquanto/da-sua-cozinha/v2/antes-depois-v2.webp"
            alt="O mesmo espaço de trabalho culinário mostrado primeiro de forma improvisada e depois organizado para vendas."
            width="1800"
            height="1344"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="cozinha-v2-state-grid">
          <article class="cozinha-v2-state cozinha-v2-state--today">
            <p class="cozinha-v2-state__label">Hoje</p>

            <ul>
              <li>Eu sei fazer, mas não sei por onde começar.</li>
              <li>Não faço ideia de quanto cobrar.</li>
              <li>Não sei o que colocar no cardápio.</li>
              <li>Tenho vergonha ou dúvida na hora de divulgar.</li>
              <li>Improviso quando alguém pergunta preço ou como pedir.</li>
            </ul>
          </article>

          <article class="cozinha-v2-state cozinha-v2-state--organized">
            <p class="cozinha-v2-state__label">
              Com as decisões organizadas
            </p>

            <ul>
              <li>Você sabe o que pretende vender primeiro.</li>
              <li>Tem uma estrutura para analisar o preço.</li>
              <li>Sabe como apresentar seus produtos.</li>
              <li>Escolhe onde começar a divulgar.</li>
              <li>Prepara o atendimento antes do primeiro pedido.</li>
            </ul>
          </article>
        </div>

        <p class="cozinha-v2-closing">
          Nada mágico aconteceu. Você continua fazendo o que já sabe fazer.
          <strong>O que muda é ter clareza sobre o que vem depois.</strong>
        </p>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-v2-roadmap"
      aria-labelledby="cozinha-roadmap-title"
    >
      <div class="cozinha-container">
        <div class="cozinha-v2-roadmap__head">
          <div>
            <p class="cozinha-kicker">Da cozinha ao primeiro pedido</p>

            <h2 id="cozinha-roadmap-title">
              Cinco decisões colocam o começo em movimento.
            </h2>

            <p class="cozinha-section__lead">
              Não é necessário resolver tudo de uma vez. Você pode seguir
              uma sequência simples e organizar uma decisão por vez.
            </p>
          </div>

          <figure class="cozinha-v2-photo cozinha-v2-roadmap__photo">
            <img
              src="/assets/enquanto/da-sua-cozinha/v2/cinco-passos-v2.webp"
              alt="Sequência visual de cinco etapas para transformar um produto de cozinha em uma oferta organizada."
              width="1800"
              height="1344"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        <div class="cozinha-v2-steps" aria-label="Cinco passos">
          <article class="cozinha-v2-step">
            <span>01</span>
            <div>
              <h3>Escolher</h3>
              <p>
                Decida o que faz mais sentido oferecer primeiro, sem tentar
                vender tudo o que sabe fazer.
              </p>
            </div>
          </article>

          <article class="cozinha-v2-step">
            <span>02</span>
            <div>
              <h3>Calcular</h3>
              <p>
                Organize ingredientes, rendimento, embalagem, custos e preço
                antes de decidir quanto cobrar.
              </p>
