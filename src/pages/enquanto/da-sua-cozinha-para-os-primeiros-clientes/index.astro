const currentYear = new Date().getFullYear();
---

<StandalonePageLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  author="Estúdio Escrita Planejada"
  siteName="Enquanto Ele Age"
  image="/assets/enquanto/da-sua-cozinha/og-image.webp"
  imageAlt="Apresentação do kit digital Da Sua Cozinha para os Primeiros Clientes"
  socialDescription="Um kit digital para organizar o que vender, entender custos e preços, divulgar seus produtos e receber os primeiros pedidos."
  twitterDescription="Kit digital para organizar os primeiros passos de quem pensa em começar a vender comida feita em casa."
  themeColor="#6f4428"
  colorScheme="light"
  bodyClass="cozinha-page"
  bodyDataPage="da-sua-cozinha"
  faviconSvg="/assets/enquanto-ele-age/favicon.svg"
  faviconPng="/assets/enquanto-ele-age/favicon-48.png"
  appleTouchIcon="/assets/enquanto-ele-age/apple-touch-icon.png"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/assets/enquanto/da-sua-cozinha/hero.webp"
      type="image/webp"
      fetchpriority="high"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    ></script>

    <script is:inline>
      (() => {
        const analyticsConsentKey = 'eep_analytics_consent';
        const analyticsConsentVersionKey = 'eep_analytics_consent_version';
        const analyticsConsentVersion = '2026-07-31-v1';
        const hotmartConsentKey = 'eep_hotmart_analytics_consent';
        const hotmartConsentVersionKey =
          'eep_hotmart_analytics_consent_version';
        const hotmartConsentVersion = '2026-08-20-v1';

        const readStorage = (key) => {
          try {
            return window.localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const saveHotmartChoice = (choice) => {
          try {
            window.localStorage.setItem(hotmartConsentKey, choice);
            window.localStorage.setItem(
              hotmartConsentVersionKey,
              hotmartConsentVersion,
            );
          } catch {
            // Sem persistência: o rastreamento permanece desativado.
          }
        };

        const hasCurrentHotmartChoice = () => {
          if (
            readStorage(hotmartConsentVersionKey) !== hotmartConsentVersion
          ) {
            return false;
          }

          const choice = readStorage(hotmartConsentKey);
          return choice === 'granted' || choice === 'denied';
        };

        const loadHotmartAnalytics = () => {
          if (
            readStorage(analyticsConsentKey) !== 'granted' ||
            readStorage(analyticsConsentVersionKey) !== analyticsConsentVersion
          ) {
            return;
          }

          if (
            readStorage(hotmartConsentVersionKey) !== hotmartConsentVersion ||
            readStorage(hotmartConsentKey) !== 'granted'
          ) {
            return;
          }

          if (document.getElementById('hotmart_launcher_script')) return;

          const script = document.createElement('script');
          script.id = 'hotmart_launcher_script';

          script.textContent = `(function(l,a,u,n,c,h,e,r){l['HotmartLauncherObject']=c;l[c]=l[c]||function(){
(l[c].q=l[c].q||[]).push(arguments)},l[c].l=1*new Date();h=a.createElement(u),
e=a.getElementsByTagName(u)[0];h.async=1;h.src=n;e.parentNode.insertBefore(h,e)
})(window,document,'script','//launcher.hotmart.com/launcher.js','hot');

hot('account','043c4a5a-6eb1-3ccb-98aa-564a403a46f9');`;

          document.head.appendChild(script);
        };

        if (
          hasCurrentHotmartChoice() &&
          readStorage(hotmartConsentKey) === 'granted'
        ) {
          loadHotmartAnalytics();
        }

        const configureHotmartConsent = () => {
          const banner = document.getElementById('eep-analytics-consent');
          const description = document.getElementById(
            'eep-analytics-description',
          );
          const acceptButton = document.getElementById('eep-analytics-accept');
          const rejectButton = document.getElementById('eep-analytics-reject');
          const settingsButton = document.getElementById(
            'eep-analytics-settings',
          );

          if (
            !banner ||
            !description ||
            !acceptButton ||
            !rejectButton ||
            !settingsButton
          ) {
            return;
          }

          description.innerHTML =
            'Usamos armazenamento local para lembrar sua escolha. Com sua autorização, o Google Analytics mede o uso do site e, somente nesta página de produto, o Hotmart Analytics mede a jornada até o checkout. Consulte <a href="/cookies/">Cookies</a> e <a href="/privacidade/">Privacidade</a>. Você pode aceitar ou recusar.';

          acceptButton.addEventListener('click', () => {
            saveHotmartChoice('granted');
            window.setTimeout(loadHotmartAnalytics, 0);
          });

          rejectButton.addEventListener('click', () => {
            saveHotmartChoice('denied');
          });

          if (!hasCurrentHotmartChoice()) {
            banner.hidden = false;
            settingsButton.hidden = true;
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener(
            'DOMContentLoaded',
            configureHotmartConsent,
            { once: true },
          );
        } else {
          configureHotmartConsent();
        }
      })();
    </script>
  </Fragment>

  <a class="cozinha-skip" href="#conteudo">
    Ir para o conteúdo principal
  </a>

  <header class="cozinha-header">
    <div class="cozinha-container cozinha-header__inner">
      <a
        class="cozinha-brand"
        href="/enquanto/"
        aria-label="Enquanto Ele Age — página principal"
      >
        <img
          src="/assets/enquanto-ele-age/img/logo.png"
          alt=""
          width="42"
          height="42"
        />
        <span>
          <strong>Enquanto Ele Age</strong>
          <small>Materiais para a vida possível</small>
        </span>
      </a>

      <a
        class="cozinha-header__cta"
        href={checkoutUrl}
        data-analytics-event="commercial_cta_click"
        data-cta-type="hotmart_checkout_header"
        data-cta-label="Começar por R$ 27,00"
      >
        Começar por R$ 27,00
      </a>
    </div>
  </header>

  <main id="conteudo">
    <nav
      class="cozinha-breadcrumb cozinha-container"
      aria-label="Caminho da página"
    >
      <a href="/enquanto/">Enquanto Ele Age</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">
        Da Sua Cozinha para os Primeiros Clientes
      </span>
    </nav>

    <section
      class="cozinha-hero"
      aria-labelledby="cozinha-hero-title"
    >
      <div class="cozinha-container cozinha-hero__grid">
        <div class="cozinha-hero__content">
          <p class="cozinha-label">Kit digital · 6 PDFs</p>

          <p class="cozinha-product-name">
            Da Sua Cozinha para os Primeiros Clientes
          </p>

          <h1 id="cozinha-hero-title">
            Já pensou em começar a vender o que você faz na sua cozinha,
            mas não sabe por onde começar?
          </h1>

          <p class="cozinha-hero__lead">
            Organize o que vender primeiro, entenda melhor custos e preços,
            monte uma apresentação simples e saiba como começar a divulgar
            e receber pedidos — mesmo que você nunca tenha vendido antes.
          </p>

          <div class="cozinha-price-summary">
            <strong>R$ 27,00</strong>
            <span>Pagamento único · acesso vitalício</span>
          </div>

          <a
            class="cozinha-button cozinha-button--primary"
            href={checkoutUrl}
            data-analytics-event="commercial_cta_click"
            data-cta-type="hotmart_checkout_hero"
            data-cta-label="Quero começar por R$ 27,00"
          >
            Quero começar por R$ 27,00
          </a>

          <ul class="cozinha-trust-list" aria-label="Condições da compra">
            <li>Compra e entrega pela Hotmart</li>
            <li>Leitura no celular e no computador</li>
            <li>7 dias para solicitar reembolso</li>
          </ul>
        </div>

        <div class="cozinha-hero__visual">
          <div class="cozinha-hero__frame">
            <img
              src="/assets/enquanto/da-sua-cozinha/hero.webp"
              alt="Capa vertical do guia Da Sua Cozinha para os Primeiros Clientes"
              width="1086"
              height="1448"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-problem"
      aria-labelledby="cozinha-problem-title"
    >
      <div class="cozinha-container cozinha-problem__grid">
        <div>
          <p class="cozinha-kicker">
            Talvez essa ideia já tenha passado pela sua cabeça
          </p>

          <h2 id="cozinha-problem-title">
            Talvez a ideia já exista. O que falta é saber o próximo passo.
          </h2>

          <p class="cozinha-section__lead">
            Talvez alguém já tenha elogiado seu bolo, seu pão, seus salgados
            ou alguma receita que você prepara em casa. A dificuldade costuma
            aparecer quando várias decisões chegam ao mesmo tempo.
          </p>
        </div>

        <ul class="cozinha-question-list">
          <li>O que vale a pena vender primeiro?</li>
          <li>Quanto cobrar?</li>
          <li>Como montar um cardápio?</li>
          <li>Como mostrar meus produtos?</li>
          <li>Posso começar pelo WhatsApp?</li>
          <li>Preciso usar redes sociais?</li>
          <li>Vale a pena entrar em aplicativos?</li>
          <li>Tenho que pagar anúncio?</li>
        </ul>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-preview"
      aria-labelledby="cozinha-preview-title"
    >
      <div class="cozinha-container">
        <p class="cozinha-kicker">Veja por dentro antes de decidir</p>

        <h2 id="cozinha-preview-title">
          Conheça páginas reais do material.
        </h2>

        <p class="cozinha-section__lead">
          Você não precisa comprar sem saber o que vai receber. As imagens
          abaixo são páginas reais do conteúdo — não apenas capas ou
          mockups de divulgação.
        </p>

        <p class="cozinha-preview__hint">
          Deslize para o lado ou use a barra de rolagem para ver as próximas páginas.
        </p>

        <div
          class="cozinha-preview__scroller"
          tabindex="0"
          aria-label="Prévia de páginas reais do material"
        >
          {
            previews.map((item) => (
              <figure class="cozinha-preview-card">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{item.label}</figcaption>
              </figure>
            ))
          }
        </div>

        <p class="cozinha-preview__note">
          O material foi desenvolvido para ser consultado conforme cada
          dúvida aparece. Você não precisa estudar tudo antes de começar.
        </p>

        <div class="cozinha-preview__cta">
          <a
            class="cozinha-button cozinha-button--primary"
            href={checkoutUrl}
            data-analytics-event="commercial_cta_click"
            data-cta-type="hotmart_checkout_preview"
            data-cta-label="Quero ter acesso ao material"
          >
            Quero ter acesso ao material
          </a>
        </div>
      </div>
    </section>

    <section
      class="cozinha-section cozinha-solution"
      aria-labelledby="cozinha-solution-title"
    >
      <div class="cozinha-container cozinha-solution__inner">
        <p class="cozinha-kicker">Um caminho em ordem</p>

        <h2 id="cozinha-solution-title">
          O caminho fica mais simples quando você sabe o que fazer primeiro.
        </h2>

        <div class="cozinha-solution__copy">
          <p>
            Em vez de tentar transformar sua cozinha em um grande negócio
