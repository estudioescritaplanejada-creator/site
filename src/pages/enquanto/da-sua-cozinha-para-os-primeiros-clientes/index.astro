        <div class="cozinha-complements__grid">
          {
            complements.map((item) => (
              <article class="cozinha-complement">
                <div class="cozinha-complement__top">
                  <span>{item.number}</span>
                  <small>{item.pages}</small>
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>

        <p class="cozinha-complements__notice">
          O Kit Complementar Completo reúne esses três materiais em
          um único PDF. Ele facilita a leitura, mas não representa
          conteúdo adicional exclusivo.
        </p>
      </div>
