---
import EepFilmesLayout from '../../layouts/EepFilmesLayout.astro';
import LandingContent from '../../components/eep-filmes/LandingContent.astro';

const title =
  'EEP Filmes | Criação audiovisual, filmes, videoclipes e vídeo com IA';

const description =
  'Filmes, videoclipes, ensaios visuais, teasers e projetos audiovisuais com direção criativa, inteligência artificial, animação, edição e pós-produção.';

const canonicalPath = '/eep-filmes/';
const baseUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, baseUrl).toString();
const siteUrl = new URL('/', baseUrl).toString();
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const serviceId = `${canonicalUrl}#service`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Estúdio Escrita Planejada',
      url: siteUrl,
      logo: new URL('/assets/img/logo.png', baseUrl).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Estúdio Escrita Planejada',
      inLanguage: 'pt-BR',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalUrl,
      name: 'EEP Filmes',
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': serviceId },
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: 'Criação audiovisual EEP Filmes',
      description:
        'Criação de filmes, videoclipes, ensaios visuais, teasers e peças audiovisuais com direção criativa, animação, edição, pós-produção e inteligência artificial.',
      provider: { '@id': organizationId },
      areaServed: {
        '@type': 'Country',
        name: 'Brasil',
      },
      serviceType: 'Criação audiovisual e produção de vídeo',
    },
  ],
};
---

<EepFilmesLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  ></script>

  <LandingContent />
</EepFilmesLayout>
