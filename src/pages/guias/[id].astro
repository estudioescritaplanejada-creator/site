---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import ArticleCard from '../../components/editorial/ArticleCard.astro';
import ArticlePromotion from '../../components/editorial/ArticlePromotion.astro';
import ArticleHeroImage from '../../components/editorial/ArticleHeroImage.astro';
import ArticleVideo from '../../components/editorial/ArticleVideo.astro';
import EditorialContentLayout from '../../layouts/EditorialContentLayout.astro';
import {
  articlePath,
  categoryInfo,
  categoryPath,
  formatArticleDate,
  getReadingMinutes,
  isPublished,
  sortArticles,
} from '../../lib/editorial';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (article) => isPublished(article));
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props as Props;
const { Content } = await render(article);
const category = categoryInfo[article.data.category];
const readingMinutes = getReadingMinutes(article.body ?? '');
const canonicalPath = articlePath(article);
const baseUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, baseUrl).toString();
const organizationId = new URL('/#organization', baseUrl).toString();
const websiteId = new URL('/#website', baseUrl).toString();
const articleId = `${canonicalUrl}#article`;
const publishedIso = article.data.publishedAt.toISOString();
const modifiedIso = (article.data.updatedAt ?? article.data.publishedAt).toISOString();
const leadMagnet = article.data.leadMagnet;

const allArticles = sortArticles(
  await getCollection('articles', (entry) => isPublished(entry)),
);
const related = allArticles
  .filter(
    (entry) =>
      entry.id !== article.id &&
      (entry.data.category === article.data.category ||
        entry.data.themes.some((theme) => article.data.themes.includes(theme))),
  )
  .slice(0, 3);

const title = article.data.seoTitle ?? `${article.data.title} | Estúdio Escrita Planejada`;
const image = article.data.image ?? '/assets/img/og-estudio-escrita-planejada.jpg';
const imageAlt =
  article.data.imageAlt ?? 'Estúdio Escrita Planejada: vida digital prática para pequenos negócios';
const publicDirectory = fileURLToPath(new URL('../../../public/', import.meta.url));

function getPublicWebpDimensions(publicPath: string) {
  const filePath = join(publicDirectory, publicPath.replace(/^\/+/, ''));
  const data = readFileSync(filePath);

  if (data.toString('ascii', 0, 4) !== 'RIFF' || data.toString('ascii', 8, 12) !== 'WEBP') {
    throw new Error(`Imagem editorial inválida: ${publicPath} não é um WebP válido.`);
  }

  let offset = 12;

  while (offset + 8 <= data.length) {
    const chunkType = data.toString('ascii', offset, offset + 4);
    const chunkSize = data.readUInt32LE(offset + 4);
    const chunkStart = offset + 8;

    if (chunkType === 'VP8X' && chunkSize >= 10) {
      return {
        width: data.readUIntLE(chunkStart + 4, 3) + 1,
        height: data.readUIntLE(chunkStart + 7, 3) + 1,
      };
    }

    if (chunkType === 'VP8L' && chunkSize >= 5 && data[chunkStart] === 0x2f) {
      const bits = data.readUInt32LE(chunkStart + 1);
      return {
        width: (bits & 0x3fff) + 1,
        height: ((bits >> 14) & 0x3fff) + 1,
      };
    }

    if (
      chunkType === 'VP8 ' &&
      chunkSize >= 10 &&
      data[chunkStart + 3] === 0x9d &&
      data[chunkStart + 4] === 0x01 &&
      data[chunkStart + 5] === 0x2a
    ) {
      return {
        width: data.readUInt16LE(chunkStart + 6) & 0x3fff,
        height: data.readUInt16LE(chunkStart + 8) & 0x3fff,
      };
    }

    offset += 8 + chunkSize + (chunkSize % 2);
  }

  throw new Error(`Não foi possível ler as dimensões da imagem editorial: ${publicPath}.`);
}

const imageDimensions = article.data.image
  ? getPublicWebpDimensions(article.data.image)
  : { width: 1200, height: 630 };
const imageWidth = imageDimensions.width;
const imageHeight = imageDimensions.height;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': articleId,
  headline: article.data.title,
  description: article.data.description,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  inLanguage: 'pt-BR',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
    url: canonicalUrl,
  },
  isPartOf: {
    '@id': websiteId,
  },
  articleSection: category.label,
  keywords: article.data.themes.join(', '),
  author: {
    '@type': 'Organization',
    '@id': organizationId,
    name: article.data.author,
    url: new URL('/', baseUrl).toString(),
  },
  publisher: {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Estúdio Escrita Planejada',
    url: new URL('/', baseUrl).toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL('/assets/img/logo.png', baseUrl).toString(),
    },
  },
  image: new URL(image, baseUrl).toString(),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: new URL('/', baseUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guias',
      item: new URL('/guias/', baseUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: category.label,
      item: new URL(categoryPath(article.data.category), baseUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: article.data.title,
      item: canonicalUrl,
    },
  ],
};

const faqQuestions = article.data.faqQuestions ?? [];
const faqAnswers = article.data.faqAnswers ?? [];

const faqItems = faqQuestions
  .map((question, index) => ({
    question,
    answer: faqAnswers[index] ?? '',
  }))
  .filter((item) => item.question && item.answer);

const faqSchema = faqItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<EditorialContentLayout
  title={title}
  description={article.data.description}
  canonicalPath={canonicalPath}
  image={image}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  section={category.label}
  tags={article.data.themes}
  active="guias"
  socialTitle={article.data.socialTitle}
  socialDescription={article.data.socialDescription}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  ></script>

  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  {faqSchema && (
    <script
      slot="head"
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  )}

  <main id="conteudo">
    <nav class="breadcrumbs" aria-label="Caminho da página">
      <div class="editorial-container">
        <ol>
          <li><a href="/">Início</a></li>
          <li><a href="/guias/">Guias</a></li>
          <li><a href={categoryPath(article.data.category)}>{category.label}</a></li>
          <li aria-current="page">{article.data.title}</li>
        </ol>
      </div>
    </nav>

    <header class="article-header">
      <div class="editorial-container article-header__inner">
        <p class="article-kicker">{category.shortLabel}</p>
        <h1>{article.data.title}</h1>
        <p class="article-header__description">{article.data.description}</p>
        <ul class="article-meta" aria-label="Informações do artigo">
          <li>Por {article.data.author}</li>
          <li><time datetime={publishedIso}>{formatArticleDate(article.data.publishedAt)}</time></li>
          <li>{readingMinutes} min de leitura</li>
          <li><a href={categoryPath(article.data.category)}>{category.label}</a></li>
        </ul>
      </div>
    </header>

    {article.data.image && article.data.imageAlt && (
      <ArticleHeroImage
        src={article.data.image}
        alt={article.data.imageAlt}
        width={imageWidth}
        height={imageHeight}
      />
    )}

    {leadMagnet && (
      <section class="lead-magnet-strip" aria-label="Material gratuito relacionado">
        <div class="editorial-container lead-magnet-strip__inner">
          <div>
            <span>Material gratuito · download direto</span>
            <strong>{leadMagnet.title}</strong>
            <p>{leadMagnet.description}</p>
          </div>
          <a
            href={leadMagnet.href}
            download
            data-analytics-event="lead_magnet_download"
            data-lead-magnet={leadMagnet.id}
            data-article-slug={article.id}
            data-cta-position="article_top"
          >
            {leadMagnet.fileLabel}
          </a>
          {leadMagnet.note && <small>{leadMagnet.note}</small>}
        </div>
      </section>
    )}

    <div class="editorial-container article-shell">
      <aside class="article-aside" aria-label="Informações complementares">
        <strong>Território editorial</strong>
        <a href={categoryPath(article.data.category)}>{category.label}</a>
        <div class="article-aside__themes" aria-label="Temas do artigo">
          {article.data.themes.map((theme) => <span>{theme}</span>)}
        </div>
      </aside>

      <article class="article-body">
        <Content />

        <ArticlePromotion
          articleSlug={article.id}
          promotion={article.data.promotion}
        />

        {article.data.video && (
          <ArticleVideo
            id={article.data.video.id}
            title={article.data.video.title}
            source={article.data.video.source}
          />
        )}
      </article>
    </div>

    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="editorial-container">
          <h2 id="related-title">Continue por aqui.</h2>
          <div class="articles-grid">
            {related.map((entry) => <ArticleCard article={entry} />)}
          </div>
        </div>
      </section>
    )}
  </main>
</EditorialContentLayout>
